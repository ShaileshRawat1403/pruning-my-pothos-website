---
import TagList from '@/components/TagList.astro';

interface Props {
  title: string;
  description?: string;
  tags?: string[];
  eyebrow?: string;
  mediaSrc?: string;
  mediaAlt?: string;
  mediaAspect?: 'wide' | 'square';
  compact?: boolean;
}

const {
  title,
  description,
  tags = [],
  eyebrow,
  mediaSrc,
  mediaAlt,
  mediaAspect = 'wide',
  compact = false,
} = Astro.props;
---

<header class:list={['entry-header', compact && 'entry-header-compact', mediaSrc && 'entry-header-with-media']}>
  <div class="entry-header-copy">
    {eyebrow && <p class="entry-eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p class="entry-lead">{description}</p>}
    {tags.length > 0 && <TagList tags={tags} label="Tags" />}
  </div>
  {mediaSrc && (
    <figure class:list={['entry-media', mediaAspect === 'square' ? 'entry-media-square' : 'entry-media-wide']}>
      <img src={mediaSrc} alt={mediaAlt ?? `Cover image for ${title}`} loading="lazy" />
    </figure>
  )}
</header>

<style>
  .entry-header {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .entry-header-with-media {
    grid-template-columns: minmax(0, 1.25fr) minmax(220px, 0.85fr);
    align-items: start;
  }
  .entry-header-compact {
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .entry-eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .entry-header h1 {
    margin-top: 0;
    margin-bottom: 0.85rem;
  }
  .entry-lead {
    margin: 0 0 1.1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }
  .entry-media {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-blockquote-bg);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-text-body) 10%, transparent);
  }
  .entry-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .entry-media-wide {
    aspect-ratio: 16 / 10;
  }
  .entry-media-square {
    aspect-ratio: 1 / 1;
  }
  @media (max-width: 820px) {
    .entry-header-with-media {
      grid-template-columns: 1fr;
    }
    .entry-media {
      max-width: 420px;
    }
  }
</style>
