<section class="knowledge-map" aria-labelledby="knowledge-map-title">
  <h2 id="knowledge-map-title">How this workspace is organized</h2>
  <p class="knowledge-map-intro">
    The work here is structured across four connected domains: systems, sentences, self, and shelf.
  </p>

  <figure class="knowledge-map-graph" aria-label="Workspace knowledge map">
    <svg viewBox="0 0 520 260" role="img" aria-labelledby="knowledge-map-graph-title" data-knowledge-map-graph>
      <title id="knowledge-map-graph-title">Knowledge map connecting systems, sentences, self, and shelf</title>
      <path class="graph-link graph-link-1" data-link-to="systems" d="M 260 130 L 132 64" />
      <path class="graph-link graph-link-2" data-link-to="sentences" d="M 260 130 L 388 64" />
      <path class="graph-link graph-link-3" data-link-to="self" d="M 260 130 L 132 196" />
      <path class="graph-link graph-link-4" data-link-to="shelf" d="M 260 130 L 388 196" />

      <g class="graph-node graph-node-core graph-drift-core" tabindex="0" role="link" data-node-name="workspace" data-href="/" aria-label="Open homepage">
        <circle cx="260" cy="130" r="34"></circle>
        <text x="260" y="136" text-anchor="middle">workspace</text>
      </g>
      <g class="graph-node graph-drift-a" tabindex="0" role="link" data-node-name="systems" data-href="/systems/" aria-label="Open systems">
        <circle cx="132" cy="64" r="25"></circle>
        <text x="132" y="68" text-anchor="middle">systems</text>
      </g>
      <g class="graph-node graph-drift-b" tabindex="0" role="link" data-node-name="sentences" data-href="/sentences/" aria-label="Open sentences">
        <circle cx="388" cy="64" r="25"></circle>
        <text x="388" y="68" text-anchor="middle">sentences</text>
      </g>
      <g class="graph-node graph-drift-c" tabindex="0" role="link" data-node-name="self" data-href="/self/" aria-label="Open self">
        <circle cx="132" cy="196" r="22"></circle>
        <text x="132" y="200" text-anchor="middle">self</text>
      </g>
      <g class="graph-node graph-drift-d" tabindex="0" role="link" data-node-name="shelf" data-href="/shelf/" aria-label="Open shelf">
        <circle cx="388" cy="196" r="23"></circle>
        <text x="388" y="200" text-anchor="middle">shelf</text>
      </g>
    </svg>
  </figure>

  <div class="knowledge-pathways">
    <h3>Suggested pathways</h3>
    <div class="pathway-list">
      <a href="/systems/" class="pathway-item">
        <span class="pathway-title">Start with systems thinking</span>
        <span class="pathway-desc">Architecture, orchestration, and reliability patterns.</span>
      </a>
      <a href="/sentences/meaning/" class="pathway-item">
        <span class="pathway-title">Explore language and meaning</span>
        <span class="pathway-desc">Short reflections on attention, meaning, and judgment.</span>
      </a>
      <a href="/shelf/local-experiments/" class="pathway-item">
        <span class="pathway-title">See experiments in practice</span>
        <span class="pathway-desc">Tooling and field notes from local AI workflows.</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  const initKnowledgeMap = () => {
    const nodes = document.querySelectorAll('.knowledge-map .graph-node[data-href]');
    const graph = document.querySelector('[data-knowledge-map-graph]');
    const links = document.querySelectorAll('.knowledge-map .graph-link[data-link-to]');

    const setActiveNode = (name) => {
      if (!graph) return;
      graph.dataset.activeNode = name || '';
      links.forEach((link) => {
        link.classList.toggle('is-active', !!name && link.getAttribute('data-link-to') === name);
      });
    };

    nodes.forEach((node) => {
      if (node.dataset.bound === 'true') return;
      node.dataset.bound = 'true';
      const href = node.getAttribute('data-href');
      const name = node.getAttribute('data-node-name');
      if (!href) return;
      node.addEventListener('mouseenter', () => {
        if (name && name !== 'workspace') setActiveNode(name);
      });
      node.addEventListener('mouseleave', () => {
        setActiveNode('');
      });
      node.addEventListener('focus', () => {
        if (name && name !== 'workspace') setActiveNode(name);
      });
      node.addEventListener('blur', () => {
        setActiveNode('');
      });
      node.addEventListener('click', () => {
        window.location.href = href;
      });
      node.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          window.location.href = href;
        }
      });
    });
  };

  initKnowledgeMap();
  document.addEventListener('astro:page-load', initKnowledgeMap);
  document.addEventListener('astro:after-swap', initKnowledgeMap);
</script>

