---
import Layout from '@/layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import ContinueBlock from '@/components/ContinueBlock.astro';
import EntryHeader from '@/components/EntryHeader.astro';
import { getAdjacentEntries, getRelatedEntries } from '@/utils/navigation';

interface Props {
  entry: CollectionEntry<'shelf'>;
  entries: CollectionEntry<'shelf'>[];
  sectionLabel: string;
  sectionHref: string;
  eyebrow?: string;
}

const { entry, entries, sectionLabel, sectionHref, eyebrow = '/shelf' } = Astro.props;
const { Content } = await entry.render();
const { previous, next } = getAdjacentEntries(entries, entry.slug);
const relatedEntries = getRelatedEntries(entries, entry.slug, entry.data.tags, 2);
const toLink = (item: CollectionEntry<'shelf'>) => ({ title: item.data.title, href: `/shelf/${item.slug}/` });
const previousLink = previous ? toLink(previous) : null;
const nextLink = next ? toLink(next) : null;
const relatedLinks = relatedEntries.map(toLink);
const mediaAspect = entry.data.artist || entry.data.album ? 'square' : 'wide';

const siteUrl = Astro.site ?? new URL('https://pruningmypothos.com');
const canonical = new URL(`/shelf/${entry.slug}/`, siteUrl).toString();
const publishDate = entry.data.publishDate ? entry.data.publishDate.toISOString() : null;

const sectionSlug = sectionHref.replace('/shelf/', '').replace('/', '');

const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Shelf',
      item: new URL('/shelf/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: sectionLabel.replace('/shelf/', ''),
      item: new URL(sectionHref, siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: entry.data.title,
      item: canonical,
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  url: canonical,
  inLanguage: 'en',
  keywords: (entry.data.tags ?? []).join(', '),
  mainEntityOfPage: canonical,
  ...(publishDate && { datePublished: publishDate }),
  author: {
    '@type': 'Person',
    name: 'Shailesh Rawat',
    url: siteUrl.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'PruningMyPothos',
    url: siteUrl.toString(),
  },
};
---

<Layout title={`${entry.data.title} | Shelf | A Thinking Workspace`} description={entry.data.description} image={entry.data.coverUrl} ogType="article" disableDefaultArticleSchema={true}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <article class="shelf-entry-page">
    <EntryHeader
      title={entry.data.title}
      description={entry.data.description}
      tags={entry.data.tags}
      eyebrow={eyebrow}
      mediaSrc={entry.data.coverUrl}
      mediaAlt={`Cover image for ${entry.data.title}`}
      mediaAspect={mediaAspect}
    />
    <div class="shelf-entry-content">
      <Content />
    </div>
    <ContinueBlock
      sectionLabel={sectionLabel}
      sectionHref={sectionHref}
      previous={previousLink}
      next={nextLink}
      related={relatedLinks}
    />
  </article>
</Layout>

<style>
  .shelf-entry-page {
    width: min(100%, 72ch);
    margin: 0 auto;
  }
  .shelf-entry-content {
    font-size: 1.05rem;
    line-height: 1.82;
  }
  .shelf-entry-content :global(h2) {
    margin-top: 2.7rem;
  }
  .shelf-entry-content :global(h3) {
    margin-top: 2.1rem;
  }
  .shelf-entry-content :global(figure) {
    margin: 1.75rem 0;
  }
  .shelf-entry-content :global(figcaption) {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .shelf-entry-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .shelf-entry-content :global(.callout) {
    margin: 1.75rem 0;
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-blockquote-bg);
    border-radius: 10px;
  }
  .shelf-entry-content :global(.toc) {
    margin: 1.5rem 0 2rem;
  }
</style>
