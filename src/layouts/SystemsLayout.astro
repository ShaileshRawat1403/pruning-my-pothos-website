---
import '../styles/systems.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Sans Serif Systems: Open tools for AI-assisted natural language programming.' } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(path);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-systems.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('systems-theme')) {
          return localStorage.getItem('systems-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      };
      document.documentElement.setAttribute('data-theme', getTheme());
    </script>
  </head>
  <body>
    <div class="grid-overlay"></div>
    
    <header class="lab-header">
      <a href="/" class="lab-logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="sys-logo-icon" style="color: var(--accent-cyan);">
          <circle cx="12" cy="12" r="9" stroke-dasharray="2.5 2.5" opacity="0.6" />
          <path d="M5 19L19 5" />
          <path d="M12 5a7 7 0 0 1 7 7" stroke-dasharray="1.5 1.5" />
          <circle cx="12" cy="12" r="2.5" fill="var(--accent-purple)" stroke="none" />
          <circle cx="19" cy="5" r="1.5" fill="var(--accent-cyan)" stroke="none" />
        </svg>
        <span>Sans Serif</span> Systems
      </a>
      <nav class="lab-nav">
        <a href="/" class:list={[{ active: isActive('/') }]}>Home</a>
        <a href="/tools/" class:list={[{ active: isActive('/tools') }]}>Tools</a>
        <a href="/canvases/" class:list={[{ active: isActive('/canvases') }]}>Canvases</a>
        <a href="/docs/" class:list={[{ active: isActive('/docs') }]}>Docs</a>
        <a href="/live-lab/" class:list={[{ active: isActive('/live-lab') }]}>Live Lab</a>
        <a href="/sentiments/" class:list={[{ active: isActive('/sentiments') }]}>Sentiments Garden</a>
        <a href="/about/" class:list={[{ active: isActive('/about') }]}>About</a>
      </nav>
      
      <div style="display: flex; gap: 0.75rem; align-items: center;">
        <button id="sys-theme-toggle" class="github-btn" style="cursor: pointer; padding: 0.45rem; border-radius: 99px;" aria-label="Toggle theme">
          <svg class="sun-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        
        <a href="https://github.com/ShaileshRawat1403" class="github-btn" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.3-3.4-1.3-.4-1-.9-1.3-.9-1.3-.8-.5.1-.5.1-.5.9.1 1.4.9 1.4.9.8 1.4 2.2 1 2.7.8.1-.6.3-1 .6-1.2-2.2-.2-4.5-1.1-4.5-4.9 0-1.1.4-2 1-2.7-.1-.2-.4-1.2.1-2.5 0 0 .8-.3 2.7 1a9.5 9.5 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.5.6.7 1 1.6 1 2.7 0 3.8-2.3 4.7-4.5 4.9.3.3.7.8.7 1.7v2.5c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main class="lab-main" style="position: relative; z-index: 10; width: 100%; max-width: 1200px; margin: 0 auto; padding: 2rem 2rem 5rem 2rem;">
      <slot />
    </main>

    <footer class="lab-footer">
      <div class="footer-content">
        <div class="footer-links-grid">
          <div class="footer-col">
            <h5>Systems</h5>
            <p style="margin-top: 0.5rem; max-width: 320px;">Open-source utilities, visual canvases, and evaluation harness templates for AI-assisted workflow development.</p>
          </div>
          <div class="footer-col">
            <h5>Ecosystem</h5>
            <a href="/tools/">Browse Store</a>
            <a href="/canvases/">Interactive Canvases</a>
            <a href="/docs/">Command Documentation</a>
          </div>
          <div class="footer-col">
            <h5>Production</h5>
            <p style="margin-top: 0.5rem;">Need custom implementations, prompts context files, or loops integrated into your team's workflow? Contact me.</p>
            <a href="mailto:shailesh.rawat1403@gmail.com" style="margin-top: 0.5rem; display: inline-block; color: var(--accent-cyan);">shailesh.rawat1403@gmail.com</a>
          </div>
        </div>
        
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Sans Serif Systems. All rights reserved.</p>
          <div class="footer-brands">
            <a href="/" class="brand-link" style="color: var(--accent-cyan);">Systems Lab</a>
            <a href="/sentiments/" class="brand-link">Sentiments Garden</a>
            <a href="/sentences/" class="brand-link">Writing Archive</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      const initSysThemeToggle = () => {
        const toggleBtn = document.getElementById('sys-theme-toggle');
        if (!toggleBtn) return;
        const sun = toggleBtn.querySelector('.sun-icon');
        const moon = toggleBtn.querySelector('.moon-icon');

        const updateIcons = (theme) => {
          if (theme === 'light') {
            sun.style.display = 'none';
            moon.style.display = 'block';
          } else {
            sun.style.display = 'block';
            moon.style.display = 'none';
          }
        };

        let currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        updateIcons(currentTheme);

        toggleBtn.addEventListener('click', () => {
          const newTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('systems-theme', newTheme);
          updateIcons(newTheme);
        });
      };
      initSysThemeToggle();
      document.addEventListener('astro:page-load', initSysThemeToggle);
      document.addEventListener('astro:after-swap', initSysThemeToggle);
    </script>
  </body>
</html>
