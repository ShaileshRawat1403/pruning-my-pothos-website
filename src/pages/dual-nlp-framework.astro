  .graph-wrap {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    flex: 1 1 auto;
    min-height: 360px;
    background:
      radial-gradient(circle at 50% 48%, color-mix(in srgb, var(--color-accent) 7%, transparent), transparent 70%),
      linear-gradient(to right, color-mix(in srgb, var(--color-border) 45%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-border) 45%, transparent) 1px, transparent 1px),
      var(--color-bg);
    background-size: auto, 26px 26px, 26px 26px, auto;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, #ffffff 8%, transparent),
      inset 0 0 24px color-mix(in srgb, var(--color-accent) 5%, transparent);
    overflow: hidden;
  }

  .graph-edges,
  .graph-nodes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.graph-link) {
    stroke: color-mix(in srgb, var(--color-border) 72%, var(--color-text-muted));
    stroke-width: 1.05;
    stroke-linecap: round;
    opacity: 0.78;
  }

  :global(.graph-node) {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border: 1px solid color-mix(in srgb, var(--color-border) 60%, #ffffff);
    background: color-mix(in srgb, var(--color-bg) 38%, #0f172a);
    color: #f8fafc;
    border-radius: 999px;
    font-size: 0.5rem;
    font-family: var(--font-mono);
    line-height: 1.15;
    text-align: center;
    padding: 0.34rem;
    white-space: normal;
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease, opacity 0.3s ease, transform 0.3s ease, filter 0.3s ease;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, #ffffff 12%, transparent),
      0 5px 10px color-mix(in srgb, #0f172a 28%, transparent);
  }

  :global(.graph-node.group-core) {
    width: 72px;
    height: 72px;
    border-color: color-mix(in srgb, var(--color-accent) 75%, #dbeafe);
    background: radial-gradient(circle at 32% 30%, #a7f3d0 0%, #14b8a6 58%, #0f766e 100%);
    font-size: 0.57rem;
    font-weight: 700;
    color: #052e2b;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, #ffffff 35%, transparent),
      0 7px 14px color-mix(in srgb, #0f766e 34%, transparent);
  }

  :global(.graph-node.group-domain) {
    border-color: color-mix(in srgb, #fbbf24 76%, #fef3c7);
    background: radial-gradient(circle at 34% 30%, #fde68a 0%, #f59e0b 60%, #b45309 100%);
    color: #451a03;
  }

  :global(.graph-node.group-ai) {
    border-color: color-mix(in srgb, #7dd3fc 72%, #dbeafe);
    background: radial-gradient(circle at 34% 30%, #bae6fd 0%, #38bdf8 58%, #0369a1 100%);
    color: #082f49;
  }

  :global(.graph-node.group-risk) {
    border-color: color-mix(in srgb, #fca5a5 72%, #fee2e2);
    background: radial-gradient(circle at 34% 30%, #fecaca 0%, #ef4444 58%, #991b1b 100%);
    color: #450a0a;
  }

  :global(.graph-node.group-infra) {
    border-color: color-mix(in srgb, #c4b5fd 76%, #ede9fe);
    background: radial-gradient(circle at 34% 30%, #ddd6fe 0%, #8b5cf6 58%, #5b21b6 100%);
    color: #2e1065;
  }

  :global(.graph-node.group-delivery) {
    border-color: color-mix(in srgb, #86efac 72%, #dcfce7);
    background: radial-gradient(circle at 34% 30%, #bbf7d0 0%, #22c55e 58%, #166534 100%);
    color: #052e16;
  }

  :global(.graph-node.is-dragging) {
    cursor: grabbing;
  }

  :global(.graph-node.is-new) {
    animation: node-enter 250ms ease;
  }

  :global(.graph-node.is-dimmed) {
    opacity: 0.15;
    filter: grayscale(100%);
  }

  :global(.graph-node.is-spotlight) {
    opacity: 1;
    z-index: 20;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 58%, transparent), 0 8px 18px rgba(0,0,0,0.3);
    transform: translate(-50%, -50%) scale(1.06);
  }

  .graph-nodes.is-imploding :global(.graph-node) {
    transform: translate(-50%, -50%) scale(0.1);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.6, -0.28, 0.735, 0.045), opacity 0.4s ease;
  }

  .graph-footnote {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.79rem;
    line-height: 1.45;
    min-height: 2.9em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .graph-footnote-muted {
    margin-top: 0.28rem;
    opacity: 0.92;
    line-height: 1.45;
    min-height: 2.9em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .graph-learning {
    margin-top: 0.26rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 84%, transparent);
    border-radius: 10px;
    background:
      linear-gradient(165deg, color-mix(in srgb, var(--color-bg) 92%, var(--color-blockquote-bg)), color-mix(in srgb, var(--color-bg) 88%, transparent));
    padding: 0.62rem 0.72rem;
  }

  .graph-learning-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .graph-learning-title {
    margin: 0.2rem 0 0.32rem;
    font-size: 0.86rem;
    font-family: var(--font-mono);
    color: var(--color-text-heading);
  }

  .graph-learning-line {
    margin: 0.22rem 0 0;
    font-size: 0.76rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .graph-learning-line strong {
    color: var(--color-text-body);
    font-weight: 600;
  }

  .output-block + .output-block {
    margin-top: 0.72rem;
  }

  .output-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding-right: 0.2rem;
  }

  .output-block h3 {
    margin: 0 0 0.36rem;
    font-family: var(--font-mono);
    font-size: 0.77rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-heading);
  }

  .output-panel h2,
  .output-panel h3,
  .output-panel h4 {
    font-family: var(--font-mono);
  }

  .output-panel li,
  .output-panel p {
    font-family: var(--font-sans);
  }

  .stack-group + .stack-group {
    margin-top: 0.42rem;
  }

  .stack-group h4 {
    margin: 0 0 0.14rem;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .output-panel ul,
  .output-panel ol {
    margin: 0;
    padding-left: 1rem;
    color: var(--color-text-body);
    font-size: 0.79rem;
    line-height: 1.45;
    cursor: default;
    min-width: 0;
  }

  .output-panel li {
    margin: 0.1rem 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .links-list a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .skills-list {
    list-style: none;
    padding-left: 0;
  }

  .skills-list li {
    display: flex;
    align-items: center;
    gap: 0.42rem;
  }

  .skill-check {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 70%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    flex-shrink: 0;
  }

  .export-button {
    margin-top: 0.72rem;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 16%, var(--color-bg)), color-mix(in srgb, var(--color-accent) 9%, var(--color-bg)));
    color: var(--color-text-heading);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.54rem 0.85rem;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .export-button:not(:disabled):hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--color-accent) 74%, var(--color-border));
    box-shadow: 0 12px 22px color-mix(in srgb, #020617 8%, transparent);
  }

  .export-button:disabled {
    opacity: 0.46;
    cursor: not-allowed;
  }

  .blueprint-card {
    margin-top: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-bg));
    border-radius: 18px;
    padding: 1rem 1.05rem;
  }

  .sandbox-value {
    margin-top: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background:
      linear-gradient(165deg, color-mix(in srgb, var(--color-bg) 96%, var(--color-blockquote-bg)), color-mix(in srgb, var(--color-bg) 92%, transparent));
    padding: 1rem 1.05rem;
  }

  .sandbox-value h2 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    font-family: var(--font-mono);
  }

  .sandbox-value-intro {
    margin: 0 0 0.72rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    max-width: 72ch;
  }

  .sandbox-value-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.72rem;
  }

  .value-card {
    border: 1px solid color-mix(in srgb, var(--color-border) 88%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-bg) 96%, var(--color-blockquote-bg));
    padding: 0.78rem 0.84rem;
  }

  .value-card h3 {
    margin: 0 0 0.25rem;
    font-size: 0.88rem;
    font-family: var(--font-mono);
  }

  .value-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.48;
    overflow-wrap: anywhere;
  }

  .blueprint-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.69rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .blueprint-card h2 {
    margin: 0.2rem 0 0.28rem;
    font-size: 1.2rem;
  }

  .blueprint-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  @keyframes node-enter {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.84);
    }

    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes lens-link-travel {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -44;
    }
  }

  @keyframes badge-pop {
    0% { transform: scale(0.5); opacity: 0; }
    60% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }

  @keyframes text-flash {
    0% { color: var(--color-text-heading); text-shadow: 0 0 8px var(--color-accent); }
    100% { color: var(--color-text-muted); text-shadow: none; }
  }

  @keyframes pulse-opacity {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  :global(.graph-node.is-pulsing) {
    z-index: 10;
  }

  :global(.graph-node.is-pulsing::after) {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    border: 2px solid var(--color-accent);
    opacity: 0;
    animation: node-pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    z-index: -1;
    pointer-events: none;
  }

  @keyframes node-pulse-ring {
    0% { transform: scale(0.95); opacity: 0.6; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-progress-fill,
    .step-block,
    .step-option,
    :global(.graph-node),
    :global(.graph-link),
    .lens-node,
    :global(.lens-link-flow),
    .lab-progress-track[aria-valuenow="0"],
    .badge,
    .lab-note.is-updating,
    :global(.graph-node.is-pulsing::after) {
      transition: none;
      animation: none !important;
    }

    .step-option:hover,
    .export-button:not(:disabled):hover,
    .hero-action:hover,
    .scenario-card:hover {
      transform: none;
    }
  }

  @media (max-width: 1120px) {
    .framework-intro,
    .builder-grid {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .scenario-grid {
      grid-template-columns: 1fr;
    }

    .sandbox-value-grid {
      grid-template-columns: 1fr;
    }

    .builder-page {
      border-radius: 1.2rem;
    }

    .lab-panel {
      height: auto;
    }

    .step-list,
    .output-scroll {
      overflow: visible;
      max-height: none;
      padding-right: 0;
    }

    .lens-grid {
      grid-template-columns: 1fr;
    }

    .constraint-panel {
      order: 2;
    }

    .graph-panel {
      order: 1;
    }

    .output-panel {
      order: 3;
    }

    .graph-wrap {
      min-height: 380px;
    }
  }

  @media (min-width: 1121px) {
    .constraint-panel,
    .output-panel {
      position: sticky;
      top: 6.2rem;
      height: auto;
      align-self: start;
      overflow: hidden;
    }

    .graph-panel {
      position: sticky;
      top: 6.2rem;
      height: auto;
      align-self: start;
      overflow: visible;
    }

    .step-list,
    .output-scroll {
      overflow: auto;
      max-height: none;
      height: 100%;
      scrollbar-gutter: stable;
    }

    .graph-wrap {
      min-height: clamp(440px, 52vh, 640px);
    }
  }

  @media (max-width: 640px) {
    .builder-shell-inner {
      width: calc(100% - 1rem);
      padding-inline: 0;
    }

    .builder-page {
      left: 0;
      transform: none;
      width: calc(100vw - 0.8rem);
      padding: 0.25rem 0 1.75rem;
      border-radius: 1rem;
    }

    .builder-head h1 {
      max-width: 12ch;
      font-size: clamp(1.62rem, 8vw, 2.15rem);
      line-height: 1.08;
      text-wrap: pretty;
    }

    .builder-head .hero-proof {
