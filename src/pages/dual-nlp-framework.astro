                item.vy *= 0.945;
                item.x += item.vx;
                item.y += item.vy;
                item.x = Math.max(item.radius, Math.min(width - item.radius, item.x));
                item.y = Math.max(item.radius, Math.min(height - item.radius, item.y));
              });
            }

            syncScene();
            requestAnimationFrame(tick);
          };

