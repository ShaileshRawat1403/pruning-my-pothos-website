              const contribution = option.contribution || {};
              nodes = [...nodes, ...(contribution.nodes || [])];
              edges = [...edges, ...(contribution.edges || [])];
              mergeStack(stack, contribution.stack || {});
              skills = [...skills, ...(contribution.skills || [])];
              notes = [...notes, ...(contribution.notes || [])];
              mapStackToNodes(contribution.stack, contribution.nodes);
            });

            const uniqueNodes = [];
            const seenNodeIds = new Set();
            nodes.forEach((node) => {
              if (!node?.id || seenNodeIds.has(node.id)) return;
              seenNodeIds.add(node.id);
              uniqueNodes.push(node);
            });
            const cappedNodes = uniqueNodes.slice(0, config.limits?.maxNodes || 18);
            const allowedIds = new Set(cappedNodes.map((node) => node.id));

            const uniqueEdges = [];
            const seenEdges = new Set();
            edges.forEach((edge) => {
              if (!edge?.source || !edge?.target) return;
              if (!allowedIds.has(edge.source) || !allowedIds.has(edge.target)) return;
              const edgeId = `${edge.source}->${edge.target}:${edge.label || ''}`;
              if (seenEdges.has(edgeId)) return;
              seenEdges.add(edgeId);
              uniqueEdges.push(edge);
            });

            return {
              nodes: cappedNodes,
              edges: uniqueEdges,
              stack: {
                buildInterface: toUnique(stack.buildInterface),
                appStack: toUnique(stack.appStack),
                aiStack: toUnique(stack.aiStack),
                opsStack: toUnique(stack.opsStack),
              },
              skills: toUnique(skills),
              notes: toUnique(notes),
              executionPlan: getExecutionPlan(),
              stackNodeMap,
            };
          };

        const LENS_LAYOUTS = {
          default: {
            core: { x: 0.5, y: 0.5 },
            domain: { x: 0.27, y: 0.52 },
            ai: { x: 0.46, y: 0.24 },
            risk: { x: 0.73, y: 0.34 },
            infra: { x: 0.65, y: 0.71 },
            delivery: { x: 0.37, y: 0.76 },
          },
          nlp: {
            core: { x: 0.5, y: 0.5 },
            domain: { x: 0.25, y: 0.45 },
            ai: { x: 0.75, y: 0.45 },
            risk: { x: 0.5, y: 0.2 },
            infra: { x: 0.4, y: 0.75 },
            delivery: { x: 0.6, y: 0.75 },
          },
          nlpg: {
            core: { x: 0.5, y: 0.5 },
            domain: { x: 0.15, y: 0.5 },
            ai: { x: 0.85, y: 0.5 },
            risk: { x: 0.5, y: 0.15 },
            infra: { x: 0.3, y: 0.85 },
            delivery: { x: 0.7, y: 0.85 },
          },
          };
          const graphState = {
            width: 1,
            height: 1,
            nodes: [],
            nodeById: new Map(),
            edges: [],
            dragging: null,
            running: false,
          };

          const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
          const resizeGraphBounds = () => {
            const rect = graphWrap.getBoundingClientRect();
            graphState.width = Math.max(1, rect.width);
            graphState.height = Math.max(1, rect.height);
            graphEdgesEl.setAttribute('viewBox', `0 0 ${graphState.width} ${graphState.height}`);
          };
          resizeGraphBounds();
          if (typeof ResizeObserver === 'function') {
            new ResizeObserver(resizeGraphBounds).observe(graphWrap);
          } else {
            window.addEventListener('resize', resizeGraphBounds);
          }

          graphWrap.addEventListener('pointermove', (event) => {
            if (!graphState.dragging) return;
            const rect = graphWrap.getBoundingClientRect();
            const dragged = graphState.dragging.item;
            dragged.x = clamp(event.clientX - rect.left, dragged.radius, graphState.width - dragged.radius);
            dragged.y = clamp(event.clientY - rect.top, dragged.radius, graphState.height - dragged.radius);
            dragged.vx = 0;
            dragged.vy = 0;
          });

          graphWrap.addEventListener('pointerup', (event) => {
            if (!graphState.dragging || graphState.dragging.pointerId !== event.pointerId) return;
            graphState.dragging.item.el.classList.remove('is-dragging');
            graphState.dragging = null;
          });

          graphWrap.addEventListener('pointercancel', () => {
            if (!graphState.dragging) return;
            graphState.dragging.item.el.classList.remove('is-dragging');
            graphState.dragging = null;
          });
          graphWrap.addEventListener('pointerleave', () => {
            if (!graphState.dragging) clearGraphHoverInsight();
          });

          const syncGraphScene = () => {
            graphState.edges.forEach((edge) => {
              edge.el.setAttribute('x1', `${edge.source.x}`);
              edge.el.setAttribute('y1', `${edge.source.y}`);
              edge.el.setAttribute('x2', `${edge.target.x}`);
              edge.el.setAttribute('y2', `${edge.target.y}`);
            });

            graphState.nodes.forEach((item) => {
              item.el.style.left = `${item.x}px`;
              item.el.style.top = `${item.y}px`;
            });
          };
          const getGraphNodeInsight = (nodeId, nodeLabel, group) => {
            const known = GRAPH_NODE_KNOWLEDGE[nodeId];
            if (known) return known;
            return {
              definition: `${nodeLabel}: ${(GROUP_EXPLANATIONS[group] || GROUP_EXPLANATIONS.delivery)}`,
              why: 'This node shapes how architecture decisions should be constrained and validated.',
              action: 'Trace its connected edges and confirm stack choices respect this constraint.',
            };
          };
          const renderLearningConsole = (title, insight) => {
            graphLearningTitle.textContent = title;
            graphLearningDefinition.innerHTML = `<strong>What it is:</strong> ${insight.definition}`;
            graphLearningWhy.innerHTML = `<strong>Why it matters:</strong> ${insight.why}`;
            graphLearningAction.innerHTML = `<strong>What to do:</strong> ${insight.action}`;
          };
          const setGraphHoverInsight = (nodeId, nodeLabel, group) => {
            hoveredGraphNodeId = nodeId;
            const insight = getGraphNodeInsight(nodeId, nodeLabel, group);
            graphFootnote.textContent = `${nodeLabel} -> ${insight.definition}`;
            renderLearningConsole(nodeLabel, insight);
          };
          const clearGraphHoverInsight = () => {
            hoveredGraphNodeId = '';
            graphFootnote.textContent = 'Hover a node to inspect why it exists in this blueprint.';
            renderLearningConsole('Intent', {
              definition: 'The primary user outcome this system is built to achieve.',
              why: 'Intent anchors architecture decisions and prevents random feature sprawl.',
              action: 'Hover any node to learn how each constraint changes build decisions.',
            });
          };

          const tickGraph = () => {
            if (!reducedMotion) {
              if (graphState.imploding) {
                const cx = graphState.width * 0.5;
                const cy = graphState.height * 0.5;
                graphState.nodes.forEach((item) => {
                  item.x += (cx - item.x) * 0.2;
                  item.y += (cy - item.y) * 0.2;
                });
              } else {
                const dragged = graphState.dragging?.item || null;
                const nodeCount = Math.max(1, graphState.nodes.length);

                graphState.edges.forEach((edge) => {
                  const dx = edge.target.x - edge.source.x;
                  const dy = edge.target.y - edge.source.y;
                  const dist = Math.max(0.001, Math.hypot(dx, dy));
                  const rest = edge.rest;
                  const stretch = dist - rest;
                  const strength = 0.0048 * stretch;
                  const ux = dx / dist;
                  const uy = dy / dist;
                  if (edge.source !== dragged) {
                    edge.source.vx += ux * strength;
                    edge.source.vy += uy * strength;
                  }
                  if (edge.target !== dragged) {
                    edge.target.vx -= ux * strength;
                    edge.target.vy -= uy * strength;
                  }
                });

                for (let i = 0; i < graphState.nodes.length; i += 1) {
                  for (let j = i + 1; j < graphState.nodes.length; j += 1) {
                    const a = graphState.nodes[i];
                    const b = graphState.nodes[j];
                    const dx = b.x - a.x;
                    const dy = b.y - a.y;
                    const distSq = Math.max(1, (dx * dx) + (dy * dy));
                    const dist = Math.sqrt(distSq);
                    const ux = dx / dist;
                    const uy = dy / dist;
                    const repel = Math.min(2.1, (2500 / distSq) + 0.06);
                    if (a !== dragged) {
                      a.vx -= ux * repel;
                      a.vy -= uy * repel;
                    }
                    if (b !== dragged) {
                      b.vx += ux * repel;
                      b.vy += uy * repel;
                    }
                  }
                }

                graphState.nodes.forEach((item) => {
                  if (item === dragged) return;
                  const waveX = Math.sin((performance.now() * 0.0011) + item.phase) * 5 * item.driftX;
                  const waveY = Math.cos((performance.now() * 0.0009) + (item.phase * 1.17)) * 4 * item.driftY;
                  const targetX = item.anchorX + waveX;
                  const targetY = item.anchorY + waveY;
                  item.vx += (targetX - item.x) * 0.0017;
                  item.vy += (targetY - item.y) * 0.0017;
                  item.vx *= 0.9;
                  item.vy *= 0.9;
                  item.x = clamp(item.x + item.vx, item.radius, graphState.width - item.radius);
                  item.y = clamp(item.y + item.vy, item.radius, graphState.height - item.radius);
                });
              }
            }

            syncGraphScene();
            requestAnimationFrame(tickGraph);
          };

          const renderGraph = (nodes, edges) => {
            const prevNodeById = new Map(graphState.nodes.map((item) => [item.id, item]));
            graphNodesEl.innerHTML = '';
            graphEdgesEl.innerHTML = '';
            graphState.nodeById = new Map();
            graphState.nodes = [];
            graphState.edges = [];

            const layout = LENS_LAYOUTS[selectedLens] || LENS_LAYOUTS.default;

            nodes.forEach((node, index) => {
              const safeGroup = layout[node.group] ? node.group : 'delivery';
              const anchor = layout[safeGroup];
              const prev = prevNodeById.get(node.id);
              const radius = node.group === 'core' ? 36 : 28;
              const jitterX = ((index % 3) - 1) * 22;
              const jitterY = ((index % 5) - 2) * 16;
              const startX = prev?.x ?? ((anchor.x * graphState.width) + jitterX);
              const startY = prev?.y ?? ((anchor.y * graphState.height) + jitterY);
              const item = {
                id: node.id,
                group: safeGroup,
                x: clamp(startX, radius, graphState.width - radius),
                y: clamp(startY, radius, graphState.height - radius),
                vx: prev?.vx || 0,
                vy: prev?.vy || 0,
                radius,
                anchorX: anchor.x * graphState.width,
                anchorY: anchor.y * graphState.height,
                phase: (index + 1) * 0.9,
                driftX: index % 2 === 0 ? 1 : -1,
                driftY: index % 3 === 0 ? -1 : 1,
                el: null,
              };

              const nodeEl = document.createElement('button');
              nodeEl.type = 'button';
              nodeEl.className = `graph-node group-${safeGroup}`;
              nodeEl.textContent = node.label;
              nodeEl.setAttribute('aria-label', node.label);
              nodeEl.title = getGraphNodeInsight(node.id, node.label, safeGroup).definition;
              nodeEl.style.left = `${item.x}px`;
              nodeEl.style.top = `${item.y}px`;
              if (!reducedMotion && !previousNodeIds.has(node.id)) nodeEl.classList.add('is-new');
              nodeEl.addEventListener('pointerenter', () => setGraphHoverInsight(node.id, node.label, safeGroup));
              nodeEl.addEventListener('focus', () => setGraphHoverInsight(node.id, node.label, safeGroup));
              nodeEl.addEventListener('pointerleave', () => clearGraphHoverInsight());
              nodeEl.addEventListener('blur', () => clearGraphHoverInsight());

              nodeEl.addEventListener('pointerdown', (event) => {
                event.preventDefault();
                event.stopPropagation();
                graphState.dragging = { item, pointerId: event.pointerId };
                nodeEl.classList.add('is-dragging');
                nodeEl.setPointerCapture(event.pointerId);
              });
              nodeEl.addEventListener('pointerup', (event) => {
                if (!graphState.dragging || graphState.dragging.pointerId !== event.pointerId) return;
                nodeEl.classList.remove('is-dragging');
                graphState.dragging = null;
              });
              nodeEl.addEventListener('pointercancel', () => {
                nodeEl.classList.remove('is-dragging');
                graphState.dragging = null;
              });

              item.el = nodeEl;
              graphState.nodes.push(item);
              graphState.nodeById.set(node.id, item);
              graphNodesEl.appendChild(nodeEl);
            });

            edges.forEach((edge) => {
              const source = graphState.nodeById.get(edge.source);
              const target = graphState.nodeById.get(edge.target);
              if (!source || !target) return;
              const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
              line.setAttribute('class', 'graph-link');
              graphEdgesEl.appendChild(line);
              graphState.edges.push({
                source,
                target,
                rest: Math.max(120, source.radius + target.radius + 40),
                el: line,
              });
            });

            previousNodeIds = new Set(nodes.map((node) => node.id));
            if (!graphState.running) {
              graphState.running = true;
              requestAnimationFrame(tickGraph);
            }
            syncGraphScene();
          };

          const highlightStackNodes = (stackLabel, active) => {
            if (!active) {
              graphState.nodes.forEach((n) => {
                n.el.classList.remove('is-dimmed', 'is-spotlight');
              });
              return;
            }
            const ids = currentStackNodeMap.get(stackLabel);
            if (!ids) return;
            graphState.nodes.forEach((n) => {
              if (ids.has(n.id)) {
                n.el.classList.add('is-spotlight');
                n.el.classList.remove('is-dimmed');
              } else {
                n.el.classList.add('is-dimmed');
                n.el.classList.remove('is-spotlight');
              }
            });
          };

          const renderStackGroups = (container, stackModel) => {
            container.innerHTML = '';
            const groups = {};
            STACK_CATEGORY_MATCHERS.forEach(m => { groups[m.label] = []; });

            const fallbackMap = {
              buildInterface: 'Compute & Interface',
              appStack: 'Compute & Interface',
              aiStack: 'AI & Orchestration',
              opsStack: 'Ops & Observability',
            };

            Object.entries(stackModel).forEach(([bucket, items]) => {
              items.forEach(item => {
                let assigned = false;
                const lower = item.toLowerCase();
                for (const def of STACK_CATEGORY_MATCHERS) {
                  if (def.keywords.some(k => lower.includes(k))) {
                    groups[def.label].push(item);
                    assigned = true;
                    break;
                  }
                }
                if (!assigned) {
                  const cat = fallbackMap[bucket] || 'Compute & Interface';
                  if (!groups[cat]) groups[cat] = [];
                  groups[cat].push(item);
                }
              });
            });

            Object.entries(groups).forEach(([label, items]) => {
              const uniqueItems = toUnique(items);
              if (!uniqueItems.length) return;

              const groupDiv = document.createElement('div');
              groupDiv.className = 'stack-group';

              const h4 = document.createElement('h4');
              h4.textContent = label;
              groupDiv.appendChild(h4);

              const ul = document.createElement('ul');
              uniqueItems.forEach(item => {
                const li = document.createElement('li');
                li.textContent = item;
                li.addEventListener('mouseenter', () => highlightStackNodes(item, true));
                li.addEventListener('mouseleave', () => highlightStackNodes(item, false));
                ul.appendChild(li);
              });
              groupDiv.appendChild(ul);
              container.appendChild(groupDiv);
            });
          };

          const renderList = (target, items) => {
            target.innerHTML = '';
            items.forEach((item) => {
              const li = document.createElement('li');
              li.textContent = item;
              li.addEventListener('mouseenter', () => highlightStackNodes(item, true));
              li.addEventListener('mouseleave', () => highlightStackNodes(item, false));
              target.appendChild(li);
            });
          };

          const renderLinks = (stack) => {
            const allStackItems = [...stack.buildInterface, ...stack.appStack, ...stack.aiStack, ...stack.opsStack];
            const hits = STACK_LINK_HINTS.filter((hint) => allStackItems.some((item) => item.toLowerCase().includes(hint.match)));
            const combined = toUnique([
              ...hits.map((item) => item.href),
              ...DEFAULT_SUGGESTED_LINKS.map((item) => item.href),
            ]);
            linksListEl.innerHTML = '';
            combined.forEach((href) => {
              const item = hits.find((link) => link.href === href) || DEFAULT_SUGGESTED_LINKS.find((link) => link.href === href);
              if (!item) return;
              const li = document.createElement('li');
              const a = document.createElement('a');
              a.href = item.href;
              a.textContent = item.label;
              li.appendChild(a);
              linksListEl.appendChild(li);
            });
            if (!linksListEl.children.length) {
              const li = document.createElement('li');
              li.textContent = 'Choose constraints to unlock targeted references.';
              linksListEl.appendChild(li);
            }
          };

          const announceLive = (message) => {
            if (!message) return;
            window.clearTimeout(liveAnnounceTimer);
            labLiveEl.textContent = '';
            liveAnnounceTimer = window.setTimeout(() => {
              labLiveEl.textContent = message;
            }, 30);
          };

          const stopCoverageAnimation = () => {
            if (coverageAnimationFrame) {
              window.cancelAnimationFrame(coverageAnimationFrame);
              coverageAnimationFrame = 0;
            }
          };

          const animateValue = (obj, start, end, duration) => {
            stopCoverageAnimation();
            coverageAnimationToken += 1;
            const token = coverageAnimationToken;
            if (start === end) {
              obj.textContent = `${end}%`;
              return;
            }
            let startTimestamp = null;
            const step = (timestamp) => {
              if (token !== coverageAnimationToken) return;
              if (!startTimestamp) startTimestamp = timestamp;
              const progress = Math.min((timestamp - startTimestamp) / duration, 1);
              obj.textContent = `${Math.floor(progress * (end - start) + start)}%`;
              if (progress < 1) {
                coverageAnimationFrame = window.requestAnimationFrame(step);
              } else {
                obj.textContent = `${end}%`;
                coverageAnimationFrame = 0;
              }
            };
            coverageAnimationFrame = window.requestAnimationFrame(step);
          };

          const getCoverage = () => {
            const answered = stepOrder.filter((stepId) => selections[stepId]).length;
            return { answered, percent: Math.round((answered / stepOrder.length) * 100) };
          };

          const syncDesktopPanelHeights = () => {
            if (!(constraintPanel instanceof HTMLElement) || !(graphPanel instanceof HTMLElement) || !(outputPanel instanceof HTMLElement)) return;
            if (window.innerWidth < 1121) {
              constraintPanel.style.height = '';
              outputPanel.style.height = '';
              return;
            }
            const graphHeight = Math.ceil(graphPanel.offsetHeight);
            if (graphHeight > 0) {
              constraintPanel.style.height = `${graphHeight}px`;
              outputPanel.style.height = `${graphHeight}px`;
            }
          };

          const buildMarkdown = (model) => {
            const selectionLines = stepOrder.map((stepId) => {
              const step = stepMap.get(stepId);
              const selected = step?.options?.find((opt) => opt.value === selections[stepId]);
              return `- **${step?.title || stepId}**: ${selected?.label || 'Not selected'}`;
            });
            const stackToSection = (title, items) => `### ${title}\n${items.map((item) => `- ${item}`).join('\n')}`;
            const glossarySection = (config.base.glossary || []).map((item) => `- **${item.term}**: ${item.definition}`).join('\n');
            return [
              '# Build Blueprint',
              '',
              `- **Lens**: ${selectedLens || 'Not selected'}`,
              '',
              '## Selections',
              ...selectionLines,
              '',
              '## Recommended Stack',
              stackToSection('Build interface', model.stack.buildInterface),
              '',
              stackToSection('App stack', model.stack.appStack),
              '',
              stackToSection('AI stack', model.stack.aiStack),
              '',
              stackToSection('Ops stack', model.stack.opsStack),
              '',
              '## Skills Checklist',
              ...model.skills.map((item) => `- [ ] ${item}`),
              '',
              '## Execution Plan',
              ...model.executionPlan.map((item) => `- ${item}`),
              '',
              '## Glossary',
              glossarySection,
            ].join('\n');
          };

          const renderBadges = (model) => {
            const badges = [];
            if (selectedLens === 'nlp') badges.push('Meaning-first');
            if (selectedLens === 'nlpg') badges.push('Execution-first');
            if (selections.regulation === 'strict' || selections.regulation === 'moderate') badges.push('Risk-aware');
            if (model.stack.aiStack.some((item) => item.toLowerCase().includes('evaluation') || item.toLowerCase().includes('eval'))) badges.push('Eval-ready');
            if (selections.scale === 'internet-scale') badges.push('Scale-ready');
            if (stepOrder.every((stepId) => selections[stepId])) badges.push('Ship-ready');

            const labels = badges.length ? badges : ['Sandbox-ready'];
            const existing = Array.from(badgesEl.children);
            const existingLabels = existing.map(el => el.textContent);

            existing.forEach(el => {
              if (!labels.includes(el.textContent)) el.remove();
            });

            labels.forEach(label => {
              if (!existingLabels.includes(label)) {
                const el = document.createElement('span');
                el.className = `badge${label === 'Sandbox-ready' ? ' badge-muted' : ''}${label === 'Ship-ready' ? ' tier-gold' : ''}`;
                el.textContent = label;
                badgesEl.appendChild(el);
              }
            });
          };

          const highlightStepNodes = (stepId, shouldHighlight) => {
            if (!stepId) return;
            const selectedValue = selections[stepId];
            if (!selectedValue) return;

            const step = stepMap.get(stepId);
            const option = step?.options?.find((item) => item.value === selectedValue);
            if (!option?.contribution?.nodes) return;

            const nodeIds = new Set(option.contribution.nodes.map((n) => n.id));

            graphState.nodes.forEach((node) => {
              if (nodeIds.has(node.id)) {
                node.el.classList.toggle('is-pulsing', shouldHighlight);
              }
            });
          };

          const update = () => {
            const model = computeModel();
            currentStackNodeMap = model.stackNodeMap;
            renderGraph(model.nodes, model.edges);
            graphCountEl.textContent = `${model.nodes.length} ${model.nodes.length === 1 ? 'node' : 'nodes'}`;
            if (!hoveredGraphNodeId) clearGraphHoverInsight();

            graphNote.textContent = model.notes[model.notes.length - 1] || 'Awaiting first constraint...';

            let nextNote = '';
            if (!selectedLens) {
              nextNote = 'Sandbox ready: choose a lens, pick a domain, and probe graph nodes.';
            } else {
              nextNote = model.notes[model.notes.length - 1] || 'Interactive sandbox active: drag and inspect graph nodes.';
            }
            if (noteEl.textContent !== nextNote) {
              noteEl.textContent = nextNote;
              noteEl.classList.remove('is-updating');
              void noteEl.offsetWidth;
              noteEl.classList.add('is-updating');
            }

            renderStackGroups(stackContainer, model.stack);

            skillsListEl.innerHTML = '';
            model.skills.forEach((item) => {
              const li = document.createElement('li');
              li.innerHTML = `<span class="skill-check" aria-hidden="true"></span>${item}`;
              skillsListEl.appendChild(li);
            });

            planListEl.innerHTML = '';
            model.executionPlan.forEach((item) => {
              const li = document.createElement('li');
              li.textContent = item;
              planListEl.appendChild(li);
            });

            renderLinks(model.stack);
            renderBadges(model);

            if (hoveredStepId) highlightStepNodes(hoveredStepId, true);

            const { answered, percent } = getCoverage();
            animateValue(coverageValue, currentCoveragePercent, percent, 600);
            currentCoveragePercent = percent;
            coverageTrack.setAttribute('aria-valuenow', String(percent));
            coverageFill.style.width = `${percent}%`;
            stepBlocks.forEach((block) => block.classList.toggle('is-complete', Boolean(selections[block.dataset.stepId || ''])));

            const complete = answered === stepOrder.length;
            if (percent === 0) {
              announcedCoverageMilestones.clear();
            } else {
              [25, 50, 75, 100].forEach((mark) => {
                if (percent >= mark && !announcedCoverageMilestones.has(mark)) {
                  announcedCoverageMilestones.add(mark);
                  announceLive(`Constraint coverage reached ${mark} percent.`);
                }
              });
            }

            blueprintCard.hidden = !complete;
            exportButton.disabled = !complete;
            if (complete) {
              blueprintSummary.textContent = `All constraints captured. ${model.nodes.length} nodes generated with deterministic stack and phased plan.`;
            }
            if (complete && !wasComplete) announceLive('Blueprint complete. Constraint coverage reached 100 percent.');
            wasComplete = complete;
            syncDesktopPanelHeights();
          };

          const selectOption = (button) => {
            const stepId = button.dataset.step;
            const value = button.dataset.value;
            if (!stepId || !value) return;
            selections[stepId] = value;
            stepList.querySelectorAll(`.step-option[data-step="${stepId}"]`).forEach((peer) => {
              const isSelected = peer === button;
              peer.classList.toggle('is-selected', isSelected);
              peer.setAttribute('aria-pressed', String(isSelected));
            });
            update();
          };

          const clearSelections = () => {
            stepOrder.forEach((stepId) => { selections[stepId] = ''; });
            stepList.querySelectorAll('.step-option').forEach((btn) => {
              btn.classList.remove('is-selected');
              btn.setAttribute('aria-pressed', 'false');
            });
          };

          const applyPreset = (button) => {
            clearSelections();
            const preset = {
              domain: button.dataset.domain || '',
              aiMode: button.dataset.aiMode || '',
              regulation: button.dataset.regulation || '',
              scale: button.dataset.scale || '',
              delivery: button.dataset.delivery || '',
            };

            Object.entries(preset).forEach(([stepId, value]) => {
              if (!value) return;
              const optionButton = stepList.querySelector(`.step-option[data-step="${stepId}"][data-value="${value}"]`);
              if (!(optionButton instanceof HTMLButtonElement)) return;
              selections[stepId] = value;
              optionButton.classList.add('is-selected');
              optionButton.setAttribute('aria-pressed', 'true');
            });

            selectedLens = button.dataset.lens || '';
            lensButtons.forEach((btn) => btn.classList.toggle('is-selected', btn.dataset.lens === selectedLens));
            presetButtons.forEach((btn) => btn.classList.toggle('is-active', btn === button));
            wasComplete = false;
            announcedCoverageMilestones.clear();
            update();
            announceLive(`${button.querySelector('.scenario-title')?.textContent || 'Preset'} loaded.`);
          };

          lensButtons.forEach((button) => {
            button.addEventListener('click', () => {
              selectedLens = button.dataset.lens || '';
              lensButtons.forEach((btn) => btn.classList.toggle('is-selected', btn === button));
              presetButtons.forEach((btn) => btn.classList.remove('is-active'));
              update();
              const firstStepButton = stepList.querySelector('.step-option[data-step="domain"]');
              if (firstStepButton instanceof HTMLButtonElement) firstStepButton.focus();
            });
          });

          presetButtons.forEach((button) => {
            button.addEventListener('click', () => {
              applyPreset(button);
            });
          });

          stepList.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const button = target.closest('.step-option');
            if (button instanceof HTMLButtonElement) selectOption(button);
          });

          stepBlocks.forEach((block) => {
            const stepId = block.dataset.stepId;
            if (!stepId) return;
            const onInteract = (active) => {
              if (active) hoveredStepId = stepId;
              else if (hoveredStepId === stepId) hoveredStepId = null;
              highlightStepNodes(stepId, active);
            };
            block.addEventListener('mouseenter', () => onInteract(true));
            block.addEventListener('mouseleave', () => onInteract(false));
            block.addEventListener('focusin', () => onInteract(true));
            block.addEventListener('focusout', (e) => {
              if (!block.contains(e.relatedTarget)) onInteract(false);
            });
          });

          stepList.addEventListener('keydown', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const button = target.closest('.step-option');
            if (!(button instanceof HTMLButtonElement)) return;
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              selectOption(button);
            }
          });

          resetButton.addEventListener('click', () => {
            const reset = () => {
              stopCoverageAnimation();
              stepOrder.forEach((stepId) => { selections[stepId] = ''; });
              selectedLens = '';
              wasComplete = false;
              announcedCoverageMilestones.clear();
              shell.querySelectorAll('.step-option').forEach((btn) => {
                btn.classList.remove('is-selected');
                btn.setAttribute('aria-pressed', 'false');
              });
              lensButtons.forEach((btn) => btn.classList.remove('is-selected'));
              presetButtons.forEach((btn) => btn.classList.remove('is-active'));
              previousNodeIds = new Set();
              update();
            };

            if (reducedMotion || !graphState.nodes.length) {
              reset();
              return;
            }

            graphState.imploding = true;
            graphNodesEl.classList.add('is-imploding');
            setTimeout(() => {
              reset();
              graphState.imploding = false;
              graphNodesEl.classList.remove('is-imploding');
            }, 500);
          });

          if (typeof ResizeObserver === 'function' && graphPanel instanceof HTMLElement) {
            new ResizeObserver(() => {
              syncDesktopPanelHeights();
            }).observe(graphPanel);
          }
          window.addEventListener('resize', () => {
            syncDesktopPanelHeights();
          });

          exportButton.addEventListener('click', () => {
            const model = computeModel();
            const markdown = buildMarkdown(model);
            const blob = new Blob([markdown], { type: 'text/markdown;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const anchor = document.createElement('a');
            anchor.href = url;
            anchor.download = 'build-blueprint.md';
            document.body.appendChild(anchor);
            anchor.click();
            anchor.remove();
            URL.revokeObjectURL(url);
          });

          update();
          syncDesktopPanelHeights();
          shell.dataset.bound = 'true';
        } catch (error) {
          console.error('Builder Lab init failed:', error);
        }
      };

      const bootBuilderLab = () => {
        requestAnimationFrame(() => {
          initBuilderLab();
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootBuilderLab, { once: true });
      } else {
        bootBuilderLab();
      }
      window.addEventListener('load', bootBuilderLab, { once: true });
      document.addEventListener('astro:page-load', bootBuilderLab);
      document.addEventListener('astro:after-swap', bootBuilderLab);
    })();
  </script>
</Layout>

