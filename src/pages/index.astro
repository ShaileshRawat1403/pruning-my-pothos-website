---
import Layout from '../layouts/SystemsLayout.astro';
import ToolStatusBadge from '../components/ToolStatusBadge.astro';

const toolCategories = [
  {
    id: 'prompt-context',
    name: 'Prompt & Context',
    desc: 'Utilities to structure raw inputs and package workspace context for LLMs.'
  },
  {
    id: 'harness-eval',
    name: 'Harness & Evaluation',
    desc: 'Harness templates to run local evaluations and score model performance.'
  },
  {
    id: 'workflow-loop',
    name: 'Workflow & Loop',
    desc: 'Orchestrators to map loops and output human-in-the-loop review gates.'
  },
  {
    id: 'docs-assets',
    name: 'Docs & Assets',
    desc: 'Documentation parsers and diagram generators to keep schemas in sync.'
  }
];

const featuredTools = [
  {
    id: 'prompt-to-json',
    category: 'prompt-context',
    status: 'live' as const,
    title: 'Prompt ➔ JSON',
    desc: 'Convert unstructured prose prompts into production-ready JSON schemas.',
    engine: 'ToolSmith',
    mode: 'Browser prototype',
    contract: 'Tessera-compatible',
    future: 'Tessera JobPack',
    output: 'JSON Schema + Example',
    install: 'tesserakit-prompts',
    href: '/tools/prompt-to-json/'
  },
  {
    id: 'workflow-to-diagram',
    category: 'workflow-loop',
    status: 'live' as const,
    title: 'Workflow ➔ Diagram',
    desc: 'Generate interactive Mermaid flowcharts and schemas from text workflows.',
    engine: 'ToolSmith',
    mode: 'Browser prototype',
    contract: 'Tessera-compatible',
    future: 'Tessera JobPack',
    output: 'Mermaid + JSON Graph',
    install: 'tesserakit-recipes',
    href: '/tools/workflow-to-diagram/'
  },
  {
    id: 'repo-context-pack',
    category: 'prompt-context',
    status: 'prototype' as const,
    title: 'Repo ➔ Context Pack',
    desc: 'Gather and compress repository structures into a single XML pack for LLM ingestion.',
    engine: 'ToolSmith',
    mode: 'Manual input',
    contract: 'Tessera-compatible',
    future: 'Tessera JobPack',
    output: 'XML Context Pack',
    install: 'tesserakit-repo',
    href: '/tools/repo-context-pack/'
  },
  {
    id: 'csv-to-eval',
    category: 'harness-eval',
    status: 'prototype' as const,
    title: 'CSV ➔ Eval Harness',
    desc: 'Convert raw CSV outputs into structured evaluation datasets and rubrics.',
    engine: 'ToolSmith',
    mode: 'Browser prototype',
    contract: 'Tessera-compatible',
    future: 'Tessera JobPack',
    output: 'JSONL + Rubric draft',
    install: 'tesserakit-evals',
    href: '/tools/csv-to-eval/'
  },
  {
    id: 'change-to-checklist',
    category: 'workflow-loop',
    status: 'prototype' as const,
    title: 'Change Request ➔ HITL Checklist',
    desc: 'Analyze codebase change requests to generate human-in-the-loop review gates.',
    engine: 'ToolSmith',
    mode: 'Browser prototype',
    contract: 'Tessera-compatible',
    future: 'Flowright',
    output: 'Review gates + checklist',
    install: 'tesserakit-core',
    href: '/tools/change-to-checklist/'
  },
  {
    id: 'notes-to-brief',
    category: 'docs-assets',
    status: 'prototype' as const,
    title: 'Code/Notes ➔ PDF Brief',
    desc: 'Transform raw dev notes and diagrams into print-ready documentation briefs.',
    engine: 'ToolSmith',
    mode: 'Browser prototype',
    contract: 'Tessera-compatible',
    future: 'Content Engine',
    output: 'Structured markdown',
    install: 'tesserakit-core',
    href: '/tools/notes-to-brief/'
  }
];

const stackLayers = [
  {
    id: 'governance',
    name: 'Governance Layer',
    solves: 'Aligns execution with organizational policy.',
    breaks: 'Agents run unguided, executing unsafe or non-compliant operations.',
    tool: 'Change Request ➔ HITL Checklist'
  },
  {
    id: 'loop',
    name: 'Execution Loops',
    solves: 'Establishes checks and balance gates.',
    breaks: 'Silent failures and hallucinations escape into production.',
    tool: 'CSV ➔ Eval Harness'
  },
  {
    id: 'workflow',
    name: 'Workflow Orchestration',
    solves: 'Structured state machines and transitions.',
    breaks: 'Brittle prompts attempt to handle multi-step workflows sequentially.',
    tool: 'Workflow ➔ Diagram'
  },
  {
    id: 'context',
    name: 'Context Architecture',
    solves: 'Provides precise working memory bounds.',
    breaks: 'Irrelevant code bloats context windows, degrading model reasoning.',
    tool: 'Repo ➔ Context Pack'
  },
  {
    id: 'prompt',
    name: 'Prompt Specification',
    solves: 'Contracts for structured inputs and outputs.',
    breaks: 'Fuzzy prompts return unstructured text that crashes JSON parsers.',
    tool: 'Prompt ➔ JSON'
  }
];
---

<Layout 
  title="Sans Serif Systems | Open Tools for Natural Language Programming"
  description="Sans Serif Systems offers browser-native utilities, visual canvases, and evaluation harness templates to design, govern, and validate AI-assisted developer workflows."
>
  <!-- Glowing blobs -->
  <div class="glow-blob glow-cyan"></div>
  <div class="glow-blob glow-purple"></div>

  <!-- Hero Section -->
  <section class="hero-section">
    <span class="hero-badge">Sans Serif Systems</span>
    <h1 class="hero-title">Open tools and live demos for<br /><span class="gradient-text">natural language programming</span></h1>
    <p class="hero-subtitle">
      Try browser-native utilities now. Local-first CLI packages are planned. Use them to convert fuzzy model outputs into repeatable production execution workflows.
    </p>
    <div class="hero-ctas">
      <a href="#tools-directory" class="btn-premium btn-primary">Explore Tools</a>
      <a href="/sentiments/" class="btn-premium btn-secondary">Enter Sans Serif Sentiments</a>
    </div>
  </section>

  <!-- Two Paths Grid -->
  <section class="two-paths-section card-glass" style="max-width: 900px; margin: 0 auto 3rem auto; padding: 2.2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; text-align: left; position: relative; z-index: 10;">
    <div style="border-right: 1px solid var(--card-border); padding-right: 2rem;">
      <h4 style="font-family: var(--font-heading); color: var(--accent-cyan); margin-bottom: 0.5rem; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Systems</h4>
      <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.6;">
        Tools, interactive canvases, workflow utilities, product docs, and live lab logs.
      </p>
    </div>
    <div>
      <h4 style="font-family: var(--font-heading); color: var(--accent-purple); margin-bottom: 0.5rem; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Sentiments</h4>
      <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.6;">
        Essays, field notes, notes, archives, and the thinker/tinkerer/translator writing garden.
      </p>
    </div>
  </section>

  <!-- Interactive Pain-Point Selector -->
  <section class="selector-section card-glass">
    <h3>What are you trying to build today?</h3>
    <div class="selector-grid">
      <button class="selector-btn" data-target="workflow-to-diagram">
        “I need to turn a text workflow into a visual diagram.”
      </button>
      <button class="selector-btn" data-target="repo-context-pack">
        “I need to package a repository for an AI assistant.”
      </button>
      <button class="selector-btn" data-target="csv-to-eval">
        “I need to generate evaluation rubrics from prompt logs.”
      </button>
      <button class="selector-btn" data-target="prompt-to-json">
        “I need to force prompts to return valid JSON schemas.”
      </button>
    </div>
  </section>

  <!-- Signature Stack Interaction -->
  <section id="signature-stack" class="stack-section">
    <div class="section-header">
      <h2>The Natural Language Programming Stack</h2>
      <p>Interactive architectural layers required to govern agentic workflows without losing control.</p>
    </div>
    
    <div class="stack-container">
      <div class="stack-visual">
        {stackLayers.map((layer) => (
          <div class="stack-layer-row" data-layer={layer.id} tabindex="0" role="button" aria-label={`Inspect ${layer.name}`}>
            <span class="layer-indicator"></span>
            <div class="layer-body">
              <span class="layer-name">{layer.name}</span>
            </div>
          </div>
        ))}
      </div>
      
      <div class="stack-details card-glass">
        <div class="details-pane" data-pane="default">
          <div class="details-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
          <h4>Inspect the Architecture</h4>
          <p>Select or hover any layer in the stack to examine how to control non-deterministic systems in production.</p>
        </div>
        {stackLayers.map((layer) => (
          <div class="details-pane" data-pane={layer.id} hidden>
            <span class="details-meta-tag">LAYER PROTOCOL</span>
            <h4>{layer.name}</h4>
            <div class="details-item">
              <strong>What it solves:</strong>
              <p>{layer.solves}</p>
            </div>
            <div class="details-item">
              <strong style="color: var(--accent-pink);">What breaks without it:</strong>
              <p>{layer.breaks}</p>
            </div>
            <div class="details-item">
              <strong>Supporting Tool:</strong>
              <p style="color: var(--accent-cyan); font-weight: 600;">{layer.tool}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools Directory -->
  <section id="tools-directory" class="directory-section">
    <div class="section-header">
      <h2>Featured Tool Bench</h2>
      <p>Six focused utilities designed to solve friction points in AI development loops.</p>
    </div>

    <!-- Category Filters -->
    <div class="category-filters">
      <button class="filter-btn active" data-filter="all">All Tools</button>
      {toolCategories.map((cat) => (
        <button class="filter-btn" data-filter={cat.id}>{cat.name}</button>
      ))}
    </div>

    <!-- Grid -->
    <div class="tools-grid">
      {featuredTools.map((tool) => (
        <div class="tool-card card-glass" data-category={tool.category} id={`card-${tool.id}`}>
          <div class="card-glow" aria-hidden="true"></div>
          <div class="tool-card-body">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
              <span class="tool-category-badge" style="margin-bottom: 0;">{toolCategories.find(c => c.id === tool.category)?.name}</span>
              <ToolStatusBadge status={tool.status} />
            </div>
            <h3>{tool.title}</h3>
            <p>{tool.desc}</p>
            
            <div class="tool-profile-list" style="margin: 1.25rem 0; border-top: 1px solid var(--card-border); padding-top: 1rem;">
              <div class="profile-row">
                <span class="profile-label">Engine</span>
                <span class="profile-val">{tool.engine}</span>
              </div>
              <div class="profile-row">
                <span class="profile-label">Mode</span>
                <span class="profile-val">{tool.mode}</span>
              </div>
              <div class="profile-row">
                <span class="profile-label">Contract</span>
                <span class="profile-val">{tool.contract}</span>
              </div>
              <div class="profile-row">
                <span class="profile-label">Future Wiring</span>
                <span class="profile-val" style="color: var(--accent-cyan);">{tool.future}</span>
              </div>
            </div>

            <div class="terminal-box" style="opacity: 0.85;">
              <span class="terminal-prompt" style="color: var(--accent-purple);">ℹ</span>
              <span style="color: var(--text-secondary); font-size: 0.82rem; margin-left: 0.4rem; font-family: var(--font-sans);">Planned CLI target: {tool.install}</span>
            </div>

            <div class="card-actions">
              {tool.status === 'live' ? (
                <a href={tool.href} class="card-btn-primary">Try Live in Browser &rarr;</a>
              ) : (
                <a href={tool.href} class="card-btn-primary" style="border-color: rgba(139, 92, 246, 0.3); color: var(--accent-purple); background: transparent;">Open Prototype Sandbox &rarr;</a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Production Help Section -->
  <section class="consulting-cta-section card-glass">
    <div class="consulting-glow"></div>
    <div class="consulting-content">
      <span class="consulting-tag">Production Support</span>
      <h2>Need production-grade architecture?</h2>
      <p>
        The tools are open-source. The production implementation is where I help. If you need eval suites, structured workflows, or human-in-the-loop controls integrated into your private repositories or codebase environments, let's talk.
      </p>
      <a href="mailto:shailesh.rawat1403@gmail.com" class="btn-premium btn-primary">Get in Touch</a>
    </div>
  </section>
</Layout>

<script is:inline>
  // Interactive Stack Layer Details Hover/Focus sync
  const initStackInteraction = () => {
    const layers = document.querySelectorAll('.stack-layer-row');
    const panes = document.querySelectorAll('.stack-details [data-pane]');

    const showPane = (layerId) => {
      panes.forEach((pane) => {
        pane.hidden = pane.getAttribute('data-pane') !== (layerId || 'default');
      });
      layers.forEach((layer) => {
        layer.classList.toggle('active', layer.getAttribute('data-layer') === layerId);
      });
    };

    layers.forEach((layer) => {
      const id = layer.getAttribute('data-layer');
      layer.addEventListener('mouseenter', () => showPane(id));
      layer.addEventListener('focus', () => showPane(id));
      layer.addEventListener('mouseleave', () => showPane(''));
      layer.addEventListener('blur', () => showPane(''));
    });
  };

  // Pain-point Selector logic
  const initPainPointSelector = () => {
    const btns = document.querySelectorAll('.selector-btn');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetCard = document.getElementById(`card-${targetId}`);
        if (targetCard) {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('highlight-flash');
          setTimeout(() => {
            targetCard.classList.remove('highlight-flash');
          }, 2000);
        }
      });
    });
  };

  // Category filtering
  const initFilters = () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.tool-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        cards.forEach((card) => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'block';
            card.style.opacity = '0';
            setTimeout(() => {
              card.style.opacity = '1';
            }, 50);
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  };

  // Copy Terminal Commands helper
  const initCopyCommands = () => {
    const copyBtns = document.querySelectorAll('.copy-terminal-btn');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmdText = btn.parentElement.querySelector('.terminal-cmd').innerText;
        navigator.clipboard.writeText(cmdText).then(() => {
          btn.innerText = 'Copied';
          setTimeout(() => {
            btn.innerText = 'Copy';
          }, 1500);
        });
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    initStackInteraction();
    initPainPointSelector();
    initFilters();
    initCopyCommands();
  });
</script>

<style>
  /* Hero Styles */
  .hero-section {
    text-align: center;
    padding: 7rem 1rem 5.5rem;
    position: relative;
    z-index: 10;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--accent-cyan);
    background-color: rgba(0, 242, 254, 0.06);
    border: 1px solid rgba(0, 242, 254, 0.2);
    margin-bottom: 1.75rem;
    box-shadow: var(--shadow-glow-cyan);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    color: var(--text-secondary);
    max-width: 68ch;
    margin: 0 auto 2.5rem;
    line-height: 1.55;
    text-wrap: balance;
  }

  .hero-ctas {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Pain-point Selector */
  .selector-section {
    max-width: 900px;
    margin: 1.5rem auto 5rem;
    padding: 2.2rem;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .selector-section h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.2px;
  }

  .selector-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .selector-btn {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.1rem 1.4rem;
    font-family: var(--font-sans);
    color: var(--text-secondary);
    font-size: 0.94rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .selector-btn:hover {
    border-color: var(--accent-cyan);
    color: var(--text-primary);
    background-color: rgba(0, 242, 254, 0.03);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow-cyan);
  }

  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header h2 {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.5px;
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 50ch;
    margin: 0 auto;
  }

  /* Architectural Stack */
  .stack-section {
    margin: 6rem auto;
  }

  .stack-container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .stack-visual {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .stack-layer-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 1.75rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
    outline: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .layer-indicator {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--text-muted);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .layer-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-secondary);
    transition: color 0.25s ease;
  }

  .stack-layer-row:hover,
  .stack-layer-row:focus-visible,
  .stack-layer-row.active {
    background: rgba(99, 102, 241, 0.05);
    border-color: var(--accent-cyan);
    transform: translateX(8px);
  }

  .stack-layer-row:hover .layer-indicator,
  .stack-layer-row:focus-visible .layer-indicator,
  .stack-layer-row.active .layer-indicator {
    background: var(--accent-cyan);
    box-shadow: var(--shadow-glow-cyan);
  }

  .stack-layer-row:hover .layer-name,
  .stack-layer-row:focus-visible .layer-name,
  .stack-layer-row.active .layer-name {
    color: var(--text-primary);
  }

  .stack-details {
    padding: 2.5rem;
    min-height: 310px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .details-pane {
    width: 100%;
    animation: fade-in-up 0.25s ease forwards;
  }

  .details-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(0, 242, 254, 0.08);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(0, 242, 254, 0.2);
  }

  .details-meta-tag {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border-radius: 99px;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.05em;
    background: rgba(139, 92, 246, 0.08);
    color: var(--accent-purple);
    border: 1px solid rgba(139, 92, 246, 0.2);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .stack-details h4 {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .details-item {
    margin-bottom: 1rem;
  }

  .details-item strong {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.25rem;
  }

  .details-item p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Tools Directory grid */
  .directory-section {
    margin: 6rem auto;
  }

  .category-filters {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    padding: 0.5rem 1.2rem;
    border-radius: 99px;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: rgba(0, 242, 254, 0.05);
    border-color: var(--accent-cyan);
    color: var(--text-primary);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .tool-card {
    position: relative;
    overflow: hidden;
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.28s cubic-bezier(0.16, 1, 0.3, 1);
