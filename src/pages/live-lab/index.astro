---
import Layout from '../../layouts/SystemsLayout.astro';

const buildLogs = [
  {
    entry: 'Lab Entry 004',
    date: '2026-06-28',
    event: 'Prompt ➔ JSON Sandbox',
    desc: 'Integrated a browser-native schema builder converting raw developer instructions into JSON validation files. Verified with client-side outputs.',
    status: 'Live Demo',
    evidence: 'Client-side output generation'
  },
  {
    entry: 'Lab Entry 003',
    date: '2026-06-28',
    event: 'Workflow ➔ Diagram Sandbox',
    desc: 'Launched the Mermaid flowchart and state compiler directly in the tools playground, translating text loops into visual charts.',
    status: 'Live Demo',
    evidence: 'Mermaid compile engine online'
  },
  {
    entry: 'Lab Entry 002',
    date: '2026-06-28',
    event: 'Systems Light Mode + Conceptual Logo',
    desc: 'Designed a systemic vector logo representing trajectory control bounds and integrated a premium light mode cycle into the layout.',
    status: 'Completed',
    evidence: 'systems-theme storage variable'
  },
  {
    entry: 'Lab Entry 001',
    date: '2026-06-28',
    event: 'Two-Door Routing Split',
    desc: 'Separated the domain into a product-led Systems Lab at / and moved the legacy thinker archive to /sentiments/.',
    status: 'Completed',
    evidence: '508 pages compiled successfully'
  }
];
---

<Layout title="Live Lab Build Ledger | Sans Serif Systems" description="Track the live release timeline, build milestones, verification checkpoints, and code split ledger history.">
  <div class="glow-blob glow-cyan"></div>
  <div class="glow-blob glow-purple"></div>

  <section class="page-header">
    <span class="meta-badge">ACTIVITY LEDGER</span>
    <h1>Live Build Lab</h1>
    <p>
      An immutable ledger-style log detailing the release timeline, verification checkpoints, and execution status of the lab.
    </p>
  </section>

  <div class="timeline-container">
    {buildLogs.map((log) => (
      <div class="timeline-item card-glass" style="margin-bottom: 2rem; padding: 2rem; border-radius: 12px; position: relative; display: flex; flex-direction: column; gap: 0.75rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--card-border); padding-bottom: 0.75rem;">
          <span style="font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; color: var(--accent-cyan);">{log.entry}</span>
          <span style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">{log.date}</span>
        </div>
        
        <h3 style="font-family: var(--font-heading); color: var(--text-primary); font-size: 1.35rem; margin: 0.25rem 0;">{log.event}</h3>
        <p style="color: var(--text-secondary); line-height: 1.6; font-size: 0.95rem; margin: 0;">{log.desc}</p>
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; flex-wrap: wrap; gap: 0.5rem; background: rgba(255,255,255,0.01); padding: 0.75rem 1rem; border-radius: 6px; border: 1px solid var(--card-border);">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 6px; height: 6px; border-radius: 99px; background: var(--accent-cyan); box-shadow: 0 0 8px var(--accent-cyan);"></span>
            <span style="font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; font-weight: bold; color: var(--text-primary);">{log.status}</span>
          </div>
          <span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">Evidence: {log.evidence}</span>
        </div>
      </div>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 4rem 1rem 3rem;
  }

  .meta-badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 99px;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.05em;
    background: rgba(0, 242, 254, 0.08);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 242, 254, 0.2);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .page-header h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .page-header p {
    color: var(--text-secondary);
    font-size: 1.15rem;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .timeline-container {
    max-width: 800px;
    margin: 2rem auto;
  }
</style>
