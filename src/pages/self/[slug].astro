---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import ContinueBlock from '@/components/ContinueBlock.astro';
import { getAdjacentEntries, getRelatedEntries } from '@/utils/navigation';
import EntryHeader from '@/components/EntryHeader.astro';

export async function getStaticPaths() {
  const selfEntries = await getCollection('self');
  return selfEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'self'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const selfEntries = await getCollection('self');
const { previous, next } = getAdjacentEntries(selfEntries, entry.slug);
const relatedEntries = getRelatedEntries(selfEntries, entry.slug, entry.data.tags, 2);
const toLink = (item) => ({ title: item.data.title, href: `/self/${item.slug}/` });
const previousLink = previous ? toLink(previous) : null;
const nextLink = next ? toLink(next) : null;
const relatedLinks = relatedEntries.map(toLink);

const siteUrl = Astro.site ?? new URL('https://pruningmypothos.com');
const canonical = new URL(`/self/${entry.slug}/`, siteUrl).toString();
const publishDate = entry.data.publishDate ? entry.data.publishDate.toISOString() : null;

const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Self',
      item: new URL('/self/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: canonical,
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  url: canonical,
  inLanguage: 'en',
  keywords: (entry.data.tags ?? []).join(', '),
  mainEntityOfPage: canonical,
  ...(publishDate && { datePublished: publishDate }),
  author: {
    '@type': 'Person',
    name: 'Shailesh Rawat',
    url: siteUrl.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'PruningMyPothos',
    url: siteUrl.toString(),
  },
};
---

<Layout
  title={`${entry.data.title} | Self | A Thinking Workspace`}
  description={entry.data.description}
  ogType="article"
  disableDefaultArticleSchema={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <article class="self-entry">
    <EntryHeader
      title={entry.data.title}
      description={entry.data.description}
      tags={entry.data.tags}
      eyebrow="/self"
      compact={true}
    />
    <Content />
    <ContinueBlock
      sectionLabel="/self"
      sectionHref="/self/"
      previous={previousLink}
      next={nextLink}
      related={relatedLinks}
    />
  </article>
</Layout>

<style>
  .self-entry {
    text-align: left;
  }
  .self-entry p:first-of-type::first-letter {
    float: none;
    font-size: inherit;
    line-height: inherit;
    margin: 0;
  }
</style>
