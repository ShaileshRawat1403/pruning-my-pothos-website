---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ContinueBlock from '@/components/ContinueBlock.astro';
import { getAdjacentEntries, getRelatedEntries } from '@/utils/navigation';
import EntryHeader from '@/components/EntryHeader.astro';

export async function getStaticPaths() {
  const sentences = await getCollection('sentences');
  return sentences.map(sentence => ({
    params: { slug: sentence.slug },
    props: sentence,
  }));
}

const sentence = Astro.props;
const { Content } = await sentence.render();
const sentences = await getCollection('sentences');
const systems = await getCollection('systems');
const { previous, next } = getAdjacentEntries(sentences, sentence.slug);
const relatedEntries = getRelatedEntries(sentences, sentence.slug, sentence.data.tags, 2);
const relatedSystems = getRelatedEntries(systems, sentence.slug, sentence.data.tags, 2);
const toLink = (entry) => ({ title: entry.data.title, href: `/sentences/${entry.slug}/` });
const toSystemLink = (entry) => ({ title: entry.data.title, href: `/systems/${entry.slug}/` });
const previousLink = previous ? toLink(previous) : null;
const nextLink = next ? toLink(next) : null;
const relatedLinks = [
  ...relatedEntries.map(toLink),
  ...relatedSystems.map(toSystemLink),
].slice(0, 4);

const siteUrl = Astro.site ?? new URL('https://pruningmypothos.com');
const canonical = new URL(`/sentences/${sentence.slug}/`, siteUrl).toString();
const publishDate = sentence.data.publishDate ? sentence.data.publishDate.toISOString() : null;

const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sentences',
      item: new URL('/sentences/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: sentence.data.title,
      item: canonical,
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: sentence.data.title,
  description: sentence.data.summary,
  url: canonical,
  inLanguage: 'en',
  keywords: (sentence.data.tags ?? []).join(', '),
  mainEntityOfPage: canonical,
  ...(publishDate && { datePublished: publishDate }),
  author: {
    '@type': 'Person',
    name: 'Shailesh Rawat',
    url: siteUrl.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'PruningMyPothos',
    url: siteUrl.toString(),
  },
  about: sentence.data.category,
};
---
<Layout
  title={`${sentence.data.title} | Sentences | A Thinking Workspace`}
  description={sentence.data.summary}
  ogType="article"
  disableDefaultArticleSchema={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <div class="sentence-detail-container">
    <div class="sentence-detail">
      <EntryHeader
        title={sentence.data.title}
        description={sentence.data.summary}
        tags={sentence.data.tags}
        eyebrow={`/sentences/${sentence.data.category.toLowerCase()}`}
        compact={true}
      />
      <div class="sentence-content">
        <Content />
      </div>
      {relatedSystems.length > 0 && (
        <aside class="context-block" aria-label="Related systems">
          <span class="context-kicker">Related systems</span>
          <p>Use the longer systems pages when you want the operational model behind this sentence, not just the distilled claim.</p>
          <ul>
            {relatedSystems.map((entry) => (
              <li><a href={`/systems/${entry.slug}/`}>{entry.data.title}</a></li>
            ))}
          </ul>
        </aside>
      )}
      <ContinueBlock
        sectionLabel="/sentences"
        sectionHref="/sentences/"
        previous={previousLink}
        next={nextLink}
        related={relatedLinks}
      />
    </div>
  </div>
</Layout>

<style>
  .sentence-detail-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 50vh;
  }
  .sentence-detail {
    max-width: 760px;
    border-left: 3px solid var(--color-accent);
    padding: 2rem;
  }
  .sentence-content {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.8;
  }
  .context-block {
    margin-top: 1.8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .context-kicker {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-bottom: 0.55rem;
  }
  .context-block p {
    margin-top: 0;
  }
  .context-block ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
