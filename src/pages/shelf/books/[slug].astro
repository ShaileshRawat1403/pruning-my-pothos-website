---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ShelfEntryPage from '@/components/ShelfEntryPage.astro';

export async function getStaticPaths() {
  const bookEntries = await getCollection('shelf', ({ id }) => id.startsWith('books/'));
  return bookEntries.map(entry => ({
    params: { slug: entry.slug.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'shelf'>;
}

const { entry } = Astro.props;
const entries = await getCollection('shelf', ({ id }) => id.startsWith('books/'));
---

<ShelfEntryPage entry={entry} entries={entries} sectionLabel="/shelf/books" sectionHref="/shelf/books/" eyebrow="/shelf/books" />
