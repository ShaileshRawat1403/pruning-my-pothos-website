---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import {sortedByDate} from '@/utils';

const cultureEntries = await getCollection('shelf', ({ id }) => id.startsWith('culture/'));
const sortedCulture = sortedByDate(cultureEntries);
---

<Layout title="Culture | Shelf">
  <h1>Culture</h1>
  <p>
    Ideas, people, and projects that shape judgment, taste, and language across the rest of this workspace.
  </p>
  <div class="culture-intro">
    <p>
      This shelf is intentionally small. It exists to show the cultural references behind the systems work, not to
      behave like a giant archive.
    </p>
    <p>
      Start here when you want to understand where certain metaphors, moods, and framing choices come from, then move
      back into <a href="/systems/">Systems</a>, <a href="/sentences/">Sentences</a>, or the wider <a href="/shelf/">Shelf</a>.
    </p>
  </div>
  <div class="card-grid">
    {sortedCulture.map(entry => (
      <a href={`/shelf/culture/${entry.slug.split('/')[1]}/`} class="card">
        <div class="card-img">Image Placeholder</div>
        <div class="card-content">
          <h2 class="card-title">{entry.data.title}</h2>
          <p class="card-description">{entry.data.description}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .culture-intro {
    margin: 1.5rem 0 2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-blockquote-bg);
  }
  .culture-intro p {
    margin: 0 0 0.8rem;
  }
  .culture-intro p:last-child {
    margin-bottom: 0;
  }
</style>
