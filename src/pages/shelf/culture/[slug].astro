---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ShelfEntryPage from '@/components/ShelfEntryPage.astro';

export async function getStaticPaths() {
  const cultureEntries = await getCollection('shelf', ({ id }) => id.startsWith('culture/'));
  return cultureEntries.map(entry => ({
    params: { slug: entry.slug.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'shelf'>;
}

const { entry } = Astro.props;
const entries = await getCollection('shelf', ({ id }) => id.startsWith('culture/'));
---

<ShelfEntryPage entry={entry} entries={entries} sectionLabel="/shelf/culture" sectionHref="/shelf/culture/" eyebrow="/shelf/culture" />
