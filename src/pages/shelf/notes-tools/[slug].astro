---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ShelfEntryPage from '@/components/ShelfEntryPage.astro';

export async function getStaticPaths() {
  const notesEntries = await getCollection('shelf', ({ id }) => id.startsWith('notes-tools/'));
  return notesEntries.map(entry => ({
    params: { slug: entry.slug.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'shelf'>;
}

const { entry } = Astro.props;
const entries = await getCollection('shelf', ({ id }) => id.startsWith('notes-tools/'));
---

<ShelfEntryPage entry={entry} entries={entries} sectionLabel="/shelf/notes-tools" sectionHref="/shelf/notes-tools/" eyebrow="/shelf/notes-tools" />
