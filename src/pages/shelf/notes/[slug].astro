---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ShelfEntryPage from '@/components/ShelfEntryPage.astro';

export async function getStaticPaths() {
  const noteEntries = await getCollection('shelf', ({ id }) => id.startsWith('notes/'));
  return noteEntries.map(entry => ({
    params: { slug: entry.slug.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'shelf'>;
}

const { entry } = Astro.props;
const entries = await getCollection('shelf', ({ id }) => id.startsWith('notes/'));
---

<ShelfEntryPage entry={entry} entries={entries} sectionLabel="/shelf/notes" sectionHref="/shelf/notes/" eyebrow="/shelf/notes" />
