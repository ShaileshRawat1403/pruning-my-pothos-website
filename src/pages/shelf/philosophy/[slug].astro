---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ShelfEntryPage from '@/components/ShelfEntryPage.astro';

export async function getStaticPaths() {
  const philosophyEntries = await getCollection('shelf', ({ id }) => id.startsWith('philosophy/'));
  return philosophyEntries.map(entry => ({
    params: { slug: entry.slug.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'shelf'>;
}

const { entry } = Astro.props;
const entries = await getCollection('shelf', ({ id }) => id.startsWith('philosophy/'));
---

<ShelfEntryPage entry={entry} entries={entries} sectionLabel="/shelf/philosophy" sectionHref="/shelf/philosophy/" eyebrow="/shelf/philosophy" />
