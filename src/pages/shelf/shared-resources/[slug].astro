---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import type { CollectionEntry } from 'astro:content';
import ResourcePdf from '@/components/ResourcePdf.astro';
import TagList from '@/components/TagList.astro';
import ContinueBlock from '@/components/ContinueBlock.astro';
import EntryHeader from '@/components/EntryHeader.astro';
import { getAdjacentEntries, getRelatedEntries } from '@/utils/navigation';

export async function getStaticPaths() {
  const resourceEntries = await getCollection('shelf', ({ id }) => id.startsWith('shared-resources/'));
  return resourceEntries.map(entry => ({
    params: { slug: entry.slug.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'shelf'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const resourceEntries = await getCollection('shelf', ({ id }) => id.startsWith('shared-resources/'));
const { previous, next } = getAdjacentEntries(resourceEntries, entry.slug);
const relatedEntries = getRelatedEntries(resourceEntries, entry.slug, entry.data.tags, 2);
const toLink = (item: CollectionEntry<'shelf'>) => ({ title: item.data.title, href: `/shelf/${item.slug}/` });
const previousLink = previous ? toLink(previous) : null;
const nextLink = next ? toLink(next) : null;
const relatedLinks = relatedEntries.map(toLink);

const siteUrl = Astro.site ?? new URL('https://pruningmypothos.com');
const canonical = new URL(`/shelf/${entry.slug}/`, siteUrl).toString();
const publishDate = entry.data.publishDate ? entry.data.publishDate.toISOString() : null;

const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Shelf',
      item: new URL('/shelf/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Shared Resources',
      item: new URL('/shelf/shared-resources/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: entry.data.title,
      item: canonical,
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  url: canonical,
  inLanguage: 'en',
  keywords: (entry.data.tags ?? []).join(', '),
  mainEntityOfPage: canonical,
  ...(publishDate && { datePublished: publishDate }),
  ...(entry.data.pdfUrl && { relatedLink: entry.data.pdfUrl }),
  author: {
    '@type': 'Person',
    name: 'Shailesh Rawat',
    url: siteUrl.toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'PruningMyPothos',
    url: siteUrl.toString(),
  },
};
---

<Layout title={entry.data.title} description={entry.data.description} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <article class="resource-entry">
    <EntryHeader
      title={entry.data.title}
      description={entry.data.description}
      tags={entry.data.tags}
      eyebrow="/shelf/shared-resources"
      mediaSrc={entry.data.coverUrl}
      mediaAlt={`Cover image for ${entry.data.title}`}
    />
    {entry.data.pdfUrl ? (
      <ResourcePdf
        title={entry.data.title}
        pdfUrl={entry.data.pdfUrl}
        coverUrl={entry.data.coverUrl}
        highlights={entry.data.resourceHighlights}
      />
    ) : null}
    {entry.data.videoUrl ? (
      <section class="resource-video" aria-label={`${entry.data.title} video resource`}>
        <h2 class="resource-video-title">Video</h2>
        <video controls preload="metadata" class="resource-video-player">
          <source src={entry.data.videoUrl} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <div class="resource-video-actions">
          <a class="resource-video-btn" href={entry.data.videoUrl} target="_blank" rel="noopener noreferrer">Open video</a>
          <a class="resource-video-btn resource-video-btn-secondary" href={entry.data.videoUrl} download>Download</a>
        </div>
      </section>
    ) : null}
    <Content />
    <ContinueBlock
      sectionLabel="/shelf/shared-resources"
      sectionHref="/shelf/shared-resources/"
      previous={previousLink}
      next={nextLink}
      related={relatedLinks}
    />
  </article>
</Layout>

<style>
  .resource-entry {
    width: min(100%, 72ch);
    margin: 0 auto;
  }
  .resource-video {
    margin: 1.75rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-blockquote-bg);
  }
  .resource-video-title {
    margin: 0 0 0.75rem 0;
    font-size: 1rem;
  }
  .resource-video-player {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: #000;
  }
  .resource-video-actions {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .resource-video-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--color-text);
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-text);
    background: transparent;
  }
  .resource-video-btn:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .resource-video-btn-secondary {
    border-style: dashed;
  }
  @media (max-width: 640px) {
    .lead {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
    .resource-video {
      padding: 0.8rem;
      margin: 1.25rem 0 1.5rem;
    }
    .resource-video-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .resource-video-btn {
      width: 100%;
      padding: 0.52rem 0.8rem;
    }
  }
</style>
