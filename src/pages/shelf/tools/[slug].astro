---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ShelfEntryPage from '@/components/ShelfEntryPage.astro';

export async function getStaticPaths() {
  const toolEntries = await getCollection('shelf', ({ id }) => id.startsWith('tools/'));
  return toolEntries.map(entry => ({
    params: { slug: entry.slug.split('/')[1] },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'shelf'>;
}

const { entry } = Astro.props;
const entries = await getCollection('shelf', ({ id }) => id.startsWith('tools/'));
---

<ShelfEntryPage entry={entry} entries={entries} sectionLabel="/shelf/tools" sectionHref="/shelf/tools/" eyebrow="/shelf/tools" />
