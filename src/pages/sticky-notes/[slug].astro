---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import ContinueBlock from '@/components/ContinueBlock.astro';
import { getAdjacentEntries, getRelatedEntries } from '@/utils/navigation';
import EntryHeader from '@/components/EntryHeader.astro';

export async function getStaticPaths() {
  const stickyNotes = await getCollection('sticky-notes');
  return stickyNotes.map(note => ({
    params: { slug: note.slug },
    props: note,
  }));
}

const note = Astro.props;
const { Content } = await note.render();
const stickyNotes = await getCollection('sticky-notes');
const systems = await getCollection('systems');
const { previous, next } = getAdjacentEntries(stickyNotes, note.slug);
const relatedEntries = getRelatedEntries(stickyNotes, note.slug, note.data.tags, 2);
const relatedSystems = getRelatedEntries(systems, note.slug, note.data.tags, 2);
const toLink = (entry) => ({ title: entry.data.title, href: `/sticky-notes/${entry.slug}/` });
const toSystemLink = (entry) => ({ title: entry.data.title, href: `/systems/${entry.slug}/` });
const previousLink = previous ? toLink(previous) : null;
const nextLink = next ? toLink(next) : null;
const relatedLinks = [
  ...relatedEntries.map(toLink),
  ...relatedSystems.map(toSystemLink),
].slice(0, 4);
---
<Layout
  title={`${note.data.title} | Sticky Notes | A Thinking Workspace`}
  description={`Sticky note: ${note.data.title}. A short working note from the thinking workspace.`}
>
  <div class="note-detail">
    <EntryHeader
      title={note.data.title}
      description="A short working note from the thinking workspace."
      tags={note.data.tags}
      eyebrow="/sticky-notes"
      compact={true}
    />
    <div class="note-content">
      <Content />
    </div>
    {relatedSystems.length > 0 && (
      <aside class="context-block" aria-label="Related systems">
        <span class="context-kicker">Continue into systems</span>
        <p>Short notes become more useful when they connect to the larger operating model behind them.</p>
        <ul>
          {relatedSystems.map((entry) => (
            <li><a href={`/systems/${entry.slug}/`}>{entry.data.title}</a></li>
          ))}
        </ul>
      </aside>
    )}
    <ContinueBlock
      sectionLabel="/sticky-notes"
      sectionHref="/sticky-notes/"
      previous={previousLink}
      next={nextLink}
      related={relatedLinks}
    />
  </div>
</Layout>

<style>
  .note-detail {
    max-width: 600px;
    margin: 0 auto;
    padding: 4rem 0;
  }
  .note-detail h1 {
    text-align: center;
  }
  .note-content {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.8;
  }
  .context-block {
    margin-top: 2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-blockquote-bg);
  }
  .context-kicker {
    display: block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .context-block p {
    margin-top: 0;
  }
  .context-block ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
