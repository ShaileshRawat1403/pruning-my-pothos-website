---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SystemsList from '@/components/SystemsList.astro';
import { systemCategories } from '../../utils/systemCategories';

const siteUrl = Astro.site ?? new URL('https://pruningmypothos.com');
const category = systemCategories.find((item) => item.slug === 'concepts');
if (!category) {
  throw new Error('Systems category not found: concepts');
}
const systems = await getCollection('systems', ({ data }) => data.category === category.title);
const canonical = new URL('/systems/concepts/', siteUrl).toString();

const breadcrumbsSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Systems',
      item: new URL('/systems/', siteUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: category.title,
      item: canonical,
    },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Systems | ${category.title}`,
  description: category.description,
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    name: `${category.title} systems articles`,
    numberOfItems: systems.length,
    itemListElement: systems.map((system, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: system.data.title,
      url: new URL(`/systems/${system.slug}/`, siteUrl).toString(),
    })),
  },
};
---
<Layout
  title={`Systems | ${category.title} | A Thinking Workspace`}
  description={category.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  <a class="category-back" href="/systems/">Back to /systems</a>
  <div class="section-head section-head--centered">
    <h1>{category.title}</h1>
    <p class="mode-line">{category.description}</p>
  </div>

  <SystemsList items={systems} tone={category.tone} columns={2} />
</Layout>

<style>
  .category-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .category-back:hover {
    color: var(--color-text-body);
  }
</style>
