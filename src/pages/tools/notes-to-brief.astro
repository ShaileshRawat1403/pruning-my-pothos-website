---
import Layout from '../../layouts/SystemsLayout.astro';
---

<Layout title="Code/Notes ➔ PDF Brief | Sans Serif Systems">
  <div class="glow-blob glow-cyan"></div>
  <div class="glow-blob glow-purple"></div>

  <!-- Breadcrumbs -->
  <div class="breadcrumbs" style="font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 2rem; color: var(--text-muted);">
    <a href="/tools/" style="color: var(--accent-cyan); text-decoration: none;">Tools</a> / <span style="color: var(--text-primary);">Code/Notes ➔ PDF Brief</span>
  </div>

  <section class="tool-hero" style="margin-bottom: 3rem;">
    <h1 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">Code/Notes ➔ PDF Brief</h1>
    <p class="subtitle" style="font-size: 1.1rem; color: var(--text-secondary); max-width: 700px; line-height: 1.6;">
      Convert unstructured developer thoughts, raw notes, and codebase snippets into structured product briefs and markdown documents.
    </p>
  </section>

  <!-- Sandbox Grid (Try Live) -->
  <section class="sandbox-section" style="margin-bottom: 5rem;">
    <div class="sandbox-container card-glass" style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2rem; border-radius: 12px; overflow: hidden; min-height: 520px;">
      <!-- Input Panel -->
      <div class="sandbox-input-panel" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-right: 1px solid var(--card-border);">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-heading); font-size: 0.9rem; font-weight: 600; color: var(--text-primary);">
          <span>1. Paste Raw Developer Notes</span>
          <button class="btn-sample" id="load-sample-btn" style="background: rgba(255,255,255,0.03); border: 1px solid var(--card-border); color: var(--text-secondary); padding: 0.3rem 0.65rem; border-radius: 4px; font-size: 0.75rem; cursor: pointer;">Load Sample</button>
        </div>
        <textarea 
          id="notes-input" 
          placeholder="Paste raw, messy notes or ideas here...
Example:
We need a light mode cycle. The user wants it.
Let's store theme key under systems-theme.
Let's make sure it doesn't bleed.
Need to add Sun/Moon icons."
          style="width: 100%; flex: 1; min-height: 250px; background: rgba(0,0,0,0.15); border: 1px solid var(--card-border); border-radius: 6px; padding: 1rem; color: var(--text-primary); font-family: var(--font-sans); font-size: 0.9rem; resize: none; outline: none; line-height: 1.6;"
        ></textarea>
        <button class="btn-premium btn-primary" style="width: 100%; padding: 0.85rem; border-radius: 6px; background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%); border: none; color: #fff; font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" id="generate-btn">
          <span>Format & Compile Brief</span>
        </button>
      </div>

      <!-- Output Panel -->
      <div class="sandbox-output-panel" style="padding: 2rem; display: flex; flex-direction: column; gap: 1rem;">
        <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-heading); font-size: 0.9rem; font-weight: 600; color: var(--text-primary);">
          <span>2. Structured Product Brief</span>
          <button class="btn-export" id="copy-json-btn" style="background: rgba(255,255,255,0.03); border: 1px solid var(--card-border); color: var(--accent-cyan); padding: 0.3rem 0.65rem; border-radius: 4px; font-size: 0.75rem; cursor: pointer; display: none;">Copy Markdown</button>
        </div>
        <div class="canvas-viewport" id="canvas-viewport" style="flex: 1; min-height: 250px; background: rgba(0,0,0,0.2); border: 1px solid var(--card-border); border-radius: 6px; display: flex; align-items: center; justify-content: center; position: relative; overflow-y: auto;">
          <div class="canvas-placeholder" id="canvas-placeholder" style="text-align: center; padding: 2rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" style="color: var(--text-muted); margin: 0 auto 1rem;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <p style="color: var(--text-secondary); font-size: 0.9rem;">Click Format & Compile Brief to view structured results</p>
          </div>
          <!-- Code display -->
          <pre class="json-code-box" id="json-code-box" style="width: 100%; height: 100%; margin: 0; padding: 1.25rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.5; color: var(--text-primary); text-align: left; overflow-x: auto;" hidden><code id="json-output"></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="details-section" style="margin-bottom: 5rem; border-top: 1px solid var(--card-border); padding-top: 3rem;">
    <div class="details-grid" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem;">
      <!-- Info Left -->
      <div class="info-content">
        <h2 style="font-family: var(--font-heading); font-size: 1.75rem; color: var(--text-primary); margin-bottom: 1.25rem;">How It Works</h2>
        <p style="color: var(--text-secondary); line-height: 1.7; font-size: 1.05rem; margin-bottom: 1.5rem;">
          This utility parses list elements, notes, and task goals inside your text and restructures them into a standard markdown document format featuring separated headings for Goals, Decisions, Risks, and Next Actions.
        </p>

        <h3 style="font-family: var(--font-heading); font-size: 1.25rem; color: var(--text-primary); margin-top: 2rem; margin-bottom: 0.75rem;">Use Cases</h3>
        <ul style="color: var(--text-secondary); padding-left: 1.2rem; line-height: 1.8; font-size: 1rem; margin-bottom: 2rem;">
          <li>Translating stream-of-consciousness dev thoughts into formal documentation.</li>
          <li>Formatting raw chat descriptions into roadmap specs.</li>
          <li>Generating next steps checklists directly from codebase post-mortem notes.</li>
        </ul>

        <h3 style="font-family: var(--font-heading); font-size: 1.25rem; color: var(--text-primary); margin-bottom: 0.75rem;">Planned CLI</h3>
        <p style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 1rem;">Deploy notes/markdown compilation offline inside your local workspace via our planned command:</p>
        <div class="terminal-box" style="position: relative; background: rgba(0,0,0,0.3); border: 1px solid var(--card-border); padding: 1rem 1.25rem; border-radius: 6px; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-primary); max-width: 600px; opacity: 0.85;">
          <span class="terminal-prompt" style="color: var(--accent-purple); font-weight: bold; margin-right: 0.5rem;">ℹ</span>
          <span style="color: var(--text-secondary); font-family: var(--font-sans);">Planned install command: pip install tesserakit-core</span>
        </div>
      </div>

      <!-- Constraints & Resources Right -->
      <div class="info-sidebar" style="display: flex; flex-direction: column; gap: 2rem;">
        <div class="sidebar-box card-glass" style="padding: 1.75rem; border-radius: 12px;">
          <h5 style="font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.85rem;">Tool Profile</h5>
          <div class="tool-profile-list">
            <div class="profile-row">
              <span class="profile-label">Status</span>
              <span class="profile-val" style="color: var(--accent-purple); font-weight: bold;">Local Prototype</span>
            </div>
            <div class="profile-row">
              <span class="profile-label">Mode</span>
              <span class="profile-val">Browser prototype</span>
            </div>
            <div class="profile-row">
              <span class="profile-label">Engine</span>
              <span class="profile-val">ToolSmith</span>
            </div>
            <div class="profile-row">
              <span class="profile-label">Contract</span>
              <span class="profile-val">Tessera-compatible</span>
            </div>
            <div class="profile-row">
              <span class="profile-label">Future Wiring</span>
              <span class="profile-val"><a href="/docs/tool-status/">Content Engine</a></span>
            </div>
            <div class="profile-row">
              <span class="profile-label">Output</span>
              <span class="profile-val">Structured markdown</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const notesInput = document.getElementById('notes-input');
  const generateBtn = document.getElementById('generate-btn');
  const copyBtn = document.getElementById('copy-json-btn');
  const loadSampleBtn = document.getElementById('load-sample-btn');
  const placeholder = document.getElementById('canvas-placeholder');
  const codeBox = document.getElementById('json-code-box');
  const codeOutput = document.getElementById('json-output');

  const sampleNotes = `Theme toggle work:
- We need a light mode cycle. The user wants it.
- Storing systems-theme in localStorage is key.
- Need to prevent state leakage to sentiments.
- Build checks are passing.`;

  loadSampleBtn.addEventListener('click', () => {
    notesInput.value = sampleNotes;
  });

  generateBtn.addEventListener('click', () => {
    const rawValue = notesInput.value.trim();
    if (!rawValue) {
      alert('Please paste some notes first.');
      return;
    }

    const lines = rawValue.split('\n').map(l => l.trim()).filter(Boolean);
    
    // Build structured markdown brief
    let mdOutput = `# Product Brief & Decisions\n\n`;
    mdOutput += `## Goals & Background\n`;
    mdOutput += `Processed from raw developer notes on: ${new Date().toLocaleDateString()}\n\n`;
    
    const decisions = [];
    const tasks = [];
    
    lines.forEach(l => {
      if (l.toLowerCase().includes('need') || l.toLowerCase().includes('want')) {
        decisions.push(l.replace(/^[-\*\s]+/, ''));
      } else if (l.startsWith('-') || l.startsWith('*')) {
        tasks.push(l.replace(/^[-\*\s]+/, ''));
      } else {
        mdOutput += `${l}\n`;
      }
    });

    if (decisions.length > 0) {
      mdOutput += `\n## Core Decisions\n`;
      decisions.forEach(d => {
        mdOutput += `- **Approved**: ${d}\n`;
      });
    }

    if (tasks.length > 0) {
      mdOutput += `\n## Action Checklist\n`;
      tasks.forEach(t => {
        mdOutput += `- [ ] ${t}\n`;
      });
    }

    codeOutput.textContent = mdOutput;
    placeholder.style.display = 'none';
    codeBox.removeAttribute('hidden');
    copyBtn.style.display = 'block';
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(codeOutput.textContent).then(() => {
      const origText = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = origText;
      }, 1500);
    });
  });
</script>
