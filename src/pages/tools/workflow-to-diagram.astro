---
import Layout from '../../layouts/SystemsLayout.astro';
---

<Layout title="Workflow ➔ Diagram | Sans Serif Systems">
  <div class="glow-blob glow-cyan"></div>
  <div class="glow-blob glow-purple"></div>

  <!-- Breadcrumbs -->
  <div class="breadcrumbs">
    <a href="/tools/">Tools</a> / <span style="color: var(--text-primary);">Workflow ➔ Diagram</span>
  </div>

  <section class="tool-hero">
    <h1>Workflow ➔ Diagram</h1>
    <p class="subtitle">Convert raw text-based processes and instructions into structured, exportable Mermaid flowcharts in real-time.</p>
  </section>

  <!-- Sandbox Grid (Try Live) -->
  <section class="sandbox-section">
    <div class="sandbox-container card-glass">
      <!-- Input Panel -->
      <div class="sandbox-input-panel">
        <div class="panel-header">
          <span>1. Input Workflow Text</span>
          <button class="btn-sample" id="load-sample-btn">Load Sample</button>
        </div>
        <textarea 
          id="workflow-input" 
          placeholder="Paste or type a step-by-step process here...
Example:
Step 1: Parse incoming webhook change requests.
Step 2: Check files modified. If only Markdown, skip human gate and auto-approve.
Step 3: If code changes, trigger RAG test suite runner.
Step 4: Audit failures. If tests fail, open GitHub issue. Else, queue deployment loop."
        ></textarea>
        <button class="btn-premium btn-primary" style="width: 100%; margin-top: 1rem;" id="generate-btn">
          <span>Generate Flowchart</span>
        </button>
      </div>

      <!-- Output Panel -->
      <div class="sandbox-output-panel">
        <div class="panel-header">
          <span>2. Live Flow Canvas</span>
          <div class="action-buttons">
            <button class="btn-export" id="copy-mermaid-btn">Copy Mermaid</button>
            <button class="btn-export" id="copy-json-btn">Copy JSON</button>
          </div>
        </div>
        <div class="canvas-viewport" id="canvas-viewport">
          <div class="canvas-placeholder" id="canvas-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" style="color: var(--text-muted);"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <p>Click Generate to render the flowchart</p>
          </div>
          <!-- Mermaid container -->
          <div class="mermaid-target" id="mermaid-target" hidden></div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="details-section">
    <div class="details-grid">
      <!-- Info Left -->
      <div class="info-content">
        <h2>How It Works</h2>
        <p>
          The tool uses a deterministic parser to analyze action items, conditionals (if/else), and transition paths in your text. It constructs a node-link syntax tree in memory, validating relationships before mapping them directly to a standard Mermaid flowchart specification.
        </p>

        <h3>Use Cases</h3>
        <ul>
          <li>Turning unstructured developer briefs into structured execution flowcharts.</li>
          <li>Generating systems logic files directly from issue notes.</li>
          <li>Designing review checkpoints and human gates into automation systems.</li>
        </ul>

        <h3>Local Installation</h3>
        <p>Run this tool in your local workspace, terminal, or build pipelines:</p>
        <div class="terminal-box">
          <span class="terminal-prompt">$</span>
          <code class="terminal-cmd">pip install sans-serif-workflow</code>
          <button class="copy-terminal-btn" id="copy-pip-btn">Copy</button>
        </div>
      </div>

      <!-- Constraints & Resources Right -->
      <div class="info-sidebar">
        <div class="sidebar-box card-glass">
          <h5>Open Source Specs</h5>
          <p><strong>License:</strong> MIT</p>
          <p><strong>Version:</strong> v1.2.0</p>
          <a href="https://github.com/ShaileshRawat1403" class="sidebar-link" target="_blank" rel="noopener noreferrer">View Repository &rarr;</a>
        </div>

        <div class="sidebar-box card-glass">
          <h5>Browser Limits</h5>
          <p>The online demo is limited to 15 nodes per generation. Local runs using the CLI do not have size or path limits.</p>
        </div>

        <div class="sidebar-box card-glass production-box">
          <h5>Need Production Setup?</h5>
          <p>If you need custom state machines, parallel workflow execution engines, or database adapters designed for your team, let me help.</p>
          <a href="mailto:shailesh.rawat1403@gmail.com" class="sidebar-link-btn">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- Load Mermaid.js directly for this page rendering -->
<script type="module" is:inline>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'dark',
    themeVariables: {
      primaryColor: '#8b5cf6',
      primaryTextColor: '#fff',
      lineColor: '#4f46e5',
      primaryBorderColor: '#374151',
    }
  });

  const workflowInput = document.getElementById('workflow-input');
  const generateBtn = document.getElementById('generate-btn');
  const loadSampleBtn = document.getElementById('load-sample-btn');
  const copyMermaidBtn = document.getElementById('copy-mermaid-btn');
  const copyJsonBtn = document.getElementById('copy-json-btn');
  const canvasPlaceholder = document.getElementById('canvas-placeholder');
  const mermaidTarget = document.getElementById('mermaid-target');
  const copyPipBtn = document.getElementById('copy-pip-btn');

  let currentMermaidCode = '';

  const sampleText = `Step 1: Check code quality checks.
Step 2: If lint fails, notify developer and halt build.
Step 3: If lint passes, run test harness suite.
Step 4: If tests pass, trigger automatic preview deployments.
Step 5: If tests fail, generate failure log and block pull request.`;

  loadSampleBtn.addEventListener('click', () => {
    workflowInput.value = sampleText;
  });

  // Client-side text-to-mermaid flowchart compiler
  const compileTextToMermaid = (text) => {
    const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    let chart = 'flowchart TD\n';
    let nodes = [];
    let connections = [];
    
    // Parse step numbers and action terms
    lines.forEach((line, index) => {
      let label = line;
      let nodeId = `node${index + 1}`;
      
      // Look for Step X prefix
      const stepMatch = line.match(/^Step\s*\d+:\s*(.*)/i);
      if (stepMatch) {
        label = stepMatch[1];
      }

      // Check if it is a conditional line
      const isConditional = line.toLowerCase().includes('if');
      
      nodes.push({ id: nodeId, label: label, isConditional });
    });

    // Make sequential transitions with conditional forks
    for (let i = 0; i < nodes.length; i++) {
      const current = nodes[i];
      let cleanLabel = current.label.replace(/"/g, '\\"');
      
      // Node definitions
      if (current.isConditional) {
        chart += `  ${current.id}{"${cleanLabel}"}\n`;
      } else {
        chart += `  ${current.id}["${cleanLabel}"]\n`;
      }

      // Generate transitions
      if (i < nodes.length - 1) {
        const next = nodes[i + 1];
        if (current.isConditional) {
          // If conditional, direct transition as "Yes" and skip next for "No"
          chart += `  ${current.id} -->|Yes| ${next.id}\n`;
          if (i < nodes.length - 2) {
            chart += `  ${current.id} -->|No| ${nodes[i + 2].id}\n`;
          }
        } else {
          chart += `  ${current.id} --> ${next.id}\n`;
        }
      }
    }

    return chart;
  };

  generateBtn.addEventListener('click', async () => {
    const text = workflowInput.value.trim();
    if (!text) return;

    try {
      currentMermaidCode = compileTextToMermaid(text);
      
      canvasPlaceholder.style.display = 'none';
      mermaidTarget.hidden = false;
      mermaidTarget.innerHTML = `<pre class="mermaid">${currentMermaidCode}</pre>`;
      
      // Re-run mermaid parser
      await mermaid.run({
        nodes: [mermaidTarget]
      });

    } catch (err) {
      console.error(err);
      mermaidTarget.innerHTML = `<div class="error-box">Failed to generate flowchart schema: ${err.message}</div>`;
    }
  });

  copyMermaidBtn.addEventListener('click', () => {
    if (!currentMermaidCode) return;
    navigator.clipboard.writeText(currentMermaidCode).then(() => {
      copyMermaidBtn.innerText = 'Copied!';
      setTimeout(() => copyMermaidBtn.innerText = 'Copy Mermaid', 1500);
    });
  });

  copyJsonBtn.addEventListener('click', () => {
    if (!currentMermaidCode) return;
    const jsonStr = JSON.stringify({ mermaid: currentMermaidCode, text: workflowInput.value }, null, 2);
    navigator.clipboard.writeText(jsonStr).then(() => {
      copyJsonBtn.innerText = 'Copied!';
      setTimeout(() => copyJsonBtn.innerText = 'Copy JSON', 1500);
    });
  });

  copyPipBtn.addEventListener('click', () => {
    navigator.clipboard.writeText('pip install sans-serif-workflow').then(() => {
      copyPipBtn.innerText = 'Copied';
      setTimeout(() => copyPipBtn.innerText = 'Copy', 1500);
    });
  });
</script>

<style>
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent-cyan);
  }

  .tool-hero {
    margin-bottom: 3.5rem;
  }

  .tool-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .tool-hero .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 65ch;
    line-height: 1.55;
  }

  /* Sandbox Container styles */
  .sandbox-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 1.5rem;
    min-height: 480px;
    margin-bottom: 6rem;
    padding: 1.5rem;
  }

  .sandbox-input-panel,
  .sandbox-output-panel {
    display: flex;
    flex-direction: column;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .btn-sample {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    transition: all 0.2s ease;
  }

  .btn-sample:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--text-primary);
  }

  .btn-export {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--accent-cyan);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 500;
    margin-left: 0.5rem;
    transition: all 0.2s ease;
  }

  .btn-export:hover {
    background: rgba(0, 242, 254, 0.06);
    border-color: var(--accent-cyan);
    box-shadow: var(--shadow-glow-cyan);
  }

  textarea {
    flex-grow: 1;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.25rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.6;
    resize: none;
    outline: none;
    transition: border-color 0.2s ease;
  }

  textarea:focus {
    border-color: var(--accent-cyan);
  }

  /* Viewport canvas */
  .canvas-viewport {
    flex-grow: 1;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: auto;
    padding: 2rem;
  }

  .canvas-placeholder {
    text-align: center;
  }

  .canvas-placeholder p {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-top: 0.75rem;
  }

  .mermaid-target {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mermaid-target pre {
    background: transparent !important;
    border: none !important;
  }

  /* Details grids */
  .details-section {
    margin-bottom: 5rem;
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 3.5rem;
  }

  .info-content h2,
  .info-content h3 {
    font-family: var(--font-heading);
    color: var(--text-primary);
    letter-spacing: -0.5px;
    margin-bottom: 1rem;
  }

  .info-content h2 { font-size: 1.75rem; }
  .info-content h3 { font-size: 1.25rem; margin-top: 2rem; }

  .info-content p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .info-content ul {
    list-style: none;
    margin-bottom: 2rem;
  }

  .info-content li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .info-content li::before {
    content: '➔';
    position: absolute;
    left: 0;
    color: var(--accent-cyan);
  }

  .terminal-box {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    position: relative;
  }

  .terminal-prompt {
    color: var(--accent-orange);
  }

  .terminal-cmd {
    color: #a7f3d0;
  }

  .copy-terminal-btn {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-size: 0.68rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .sidebar-box {
    padding: 1.75rem;
  }

  .sidebar-box h5 {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.85rem;
  }

  .sidebar-box p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .sidebar-box p:last-of-type {
    margin-bottom: 0;
  }

  .sidebar-link {
    color: var(--accent-cyan);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.88rem;
  }

  .sidebar-link:hover {
    text-decoration: underline;
  }

  .production-box {
    border-color: rgba(249, 115, 22, 0.25);
    background-color: rgba(249, 115, 22, 0.02);
  }

  .sidebar-link-btn {
    display: block;
    text-align: center;
    padding: 0.65rem;
    border-radius: 99px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    color: #ffffff;
    background: linear-gradient(135deg, var(--accent-orange) 0%, var(--accent-pink) 100%);
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
    transition: all 0.2s ease;
  }

  .sidebar-link-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(249, 115, 22, 0.25);
  }

  @media (max-width: 900px) {
    .sandbox-container {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    textarea {
      min-height: 200px;
    }
    .canvas-viewport {
      min-height: 300px;
    }
    .details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
